chat.busy_multiplayer = {name}: Desculpe, estou conversando com outra pessoa no momento.
chat.cancel = {name}: Tudo bem, até mais! Se precisar é só chamar.
chat.magic.start = {name}: Oba! Vamos jogar MagicGinn. Pense em um animal e me responda com Sim (Yes) ou Não (No).
chat.magic.reject = {name}: Nós não somos tão próximos para eu brincar com você.
chat.busy_job = {name}: Já estou ocupado com meu trabalho de {job}!
chat.come = {name}: Estou indo!
chat.greeting.1 = {name}: Opa, chamou? Precisando de algo? (Diga 'pescar', 'minerar', etc)
chat.greeting.2 = {name}: Fala tu! Qual a boa de hoje? (Diga 'pescar', 'minerar', etc)
chat.greeting.3 = {name}: Oi! Tem alguma missão pra mim? (Diga 'pescar', 'minerar', etc)
chat.greeting.4 = {name}: Estou aqui. O que quer que eu faça? (Diga 'pescar', 'minerar', etc)
chat.greeting.5 = {name}: Ei! Pronto pro trabalho. Diga o que precisa. (Diga 'pescar', 'minerar', etc)
chat.smalltalk.1 = {name}: E aí! Tá um dia bom pra explorar, né?
chat.smalltalk.2 = {name}: Opa! Tudo tranquilo por aí?
chat.smalltalk.3 = {name}: Que doideira! Mas e aí, tem alguma novidade?
chat.smalltalk.4 = {name}: Haha, pode crer. Você sempre com essas ideias.
chat.smalltalk.5 = {name}: Pois é! Eu tava ali pensando sobre o que vamos fazer amanhã.
chat.smalltalk.6 = {name}: Aham... Sabe que eu tava com uma vontade de comer alguma coisa agora?
chat.smalltalk.7 = {name}: Nossa, sim! Eu tava pensando exatamente a mesma coisa!
chat.smalltalk.8 = {name}: Cuidado com os monstros à noite, ouvi uns barulhos estranhos ontem...
chat.smalltalk.9 = {name}: Ah, legal. Mas e aí, bora fazer alguma coisa?
chat.smalltalk.10 = {name}: Interessante... se bem que eu tô mais focado em trabalhar e ganhar umas moedas.
chat.magic.win = {name}: Eu já sei! O animal que você pensou é: {animal_name}!
chat.magic.lose = {name}: Não consegui adivinhar! Você me venceu!
chat.magic.question = {name}: Pergunta {num}: {question}
chat.prof.reject = {name}: Você não é meu chefe! Não vou mudar de profissão só porque você mandou. (Requer 20 de amizade)
chat.prof.accept = {name}: Muito bem, a partir de hoje eu serei um {prof_name}!
chat.prof.invalid = {name}: Não entendi qual profissão você quer que eu tenha. Tente 'vire minerador', 'vire fazendeiro', etc.
chat.job.wrong_prof = {name}: Desculpe, eu sou um {prof_name} e não sei fazer trabalho de {job_name}!
chat.job.reject = {name}: Nós mal nos conhecemos! Eu não vou trabalhar para você de graça. (Requer 10 de amizade)
chat.job.accept = {name}: Certo, me preparando para ir fazer trabalho de {job_name}!

tick.job.depart = {name}: Estou saindo agora! Volto assim que terminar.
tick.job.complete = {name}: Terminei meu trabalho de {job_name} e voltei!
tick.chat.timeout = {name}: Hmm, acho que você está ocupado. Depois nos falamos!

cmd.spawn.usage = Uso correto: /simtale spawn [NPCType]
cmd.spawn.error = Erro ao spawnar NPC do tipo {type}.
cmd.spawn.success = NPC do tipo {type} spawnado!
cmd.reload.db = Remontando NPCs do banco de dados...
cmd.here.success = Chamou {count} NPCs para a sua posição!
chat.magic.cancel = {name}: Ah, que pena! A gente joga depois então.
chat.magic.invalid = {name}: Não entendi! Responda: Sim (Yes), Não (No), Não sei (Don't know), ou Sair (Quit).
cmd.interact.none = Nenhum NPC vivo por perto!
cmd.interact.success = Forced UI to open for {name}
