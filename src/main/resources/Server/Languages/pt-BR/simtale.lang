chat.busy_multiplayer.1 = {name}: Desculpe, estou conversando com outra pessoa no momento.
chat.busy_multiplayer.2 = {name}: Opa, espera aí. Tô no meio de um papo aqui!
chat.busy_multiplayer.3 = {name}: Foi mal, tô ocupado conversando agora.
chat.cancel.1 = {name}: Tudo bem, até mais! Se precisar é só chamar.
chat.cancel.2 = {name}: Beleza, vou nessa! Qualquer coisa me grita.
chat.cancel.3 = {name}: Tranquilo! Nos vemos por aí!
chat.magic.start.1 = {name}: Oba! Vamos jogar MagicGinn. Pense em um animal e me responda com Sim (Yes) ou Não (No).
chat.magic.start.2 = {name}: Legal! Pense num bicho aí e vamos pro MagicGinn! Só vale responder Sim ou Não.
chat.magic.start.3 = {name}: Adoro esse jogo! Foca num animal que eu vou adivinhar. Responda Sim ou Não!
chat.magic.reject.1 = {name}: Nós não somos tão próximos para eu brincar com você.
chat.magic.reject.2 = {name}: Hmm... acho que a gente precisa se conhecer melhor antes de brincar.
chat.magic.reject.3 = {name}: Ah, não tô muito afim agora. A gente quase não se fala!
chat.busy_job.1 = {name}: Já estou ocupado com meu trabalho de {job}!
chat.busy_job.2 = {name}: Não posso agora, tô focado no meu trampo de {job}!
chat.busy_job.3 = {name}: Foi mal, tô no meio do expediente como {job}!
chat.come.1 = {name}: Estou indo!
chat.come.2 = {name}: Chegando!
chat.come.3 = {name}: Tô a caminho, me espera!
chat.greeting.1 = {name}: Opa, chamou? Precisando de algo? (Diga 'pescar', 'minerar', etc)
chat.greeting.2 = {name}: Fala tu! Qual a boa de hoje? (Diga 'pescar', 'minerar', etc)
chat.greeting.3 = {name}: Oi! Tem alguma missão pra mim? (Diga 'pescar', 'minerar', etc)
chat.greeting.4 = {name}: Estou aqui. O que quer que eu faça? (Diga 'pescar', 'minerar', etc)
chat.greeting.5 = {name}: Ei! Pronto pro trabalho. Diga o que precisa. (Diga 'pescar', 'minerar', etc)
chat.smalltalk.1 = {name}: E aí! Tá um dia bom pra explorar, né?
chat.smalltalk.2 = {name}: Opa! Tudo tranquilo por aí?
chat.smalltalk.3 = {name}: Que doideira! Mas e aí, tem alguma novidade?
chat.smalltalk.4 = {name}: Haha, pode crer. Você sempre com essas ideias.
chat.smalltalk.5 = {name}: Pois é! Eu tava ali pensando sobre o que vamos fazer amanhã.
chat.smalltalk.6 = {name}: Aham... Sabe que eu tava com uma vontade de comer alguma coisa agora?
chat.smalltalk.7 = {name}: Nossa, sim! Eu tava pensando exatamente a mesma coisa!
chat.smalltalk.8 = {name}: Cuidado com os monstros à noite, ouvi uns barulhos estranhos ontem...
chat.smalltalk.9 = {name}: Ah, legal. Mas e aí, bora fazer alguma coisa?
chat.smalltalk.10 = {name}: Interessante... se bem que eu tô mais focado em trabalhar e ganhar umas moedas.
chat.magic.win.1 = {name}: Eu já sei! O animal que você pensou é: {animal_name}!
chat.magic.win.2 = {name}: Muito fácil! Você pensou num(a) {animal_name}!
chat.magic.win.3 = {name}: Rá! Adivinhei! É um(a) {animal_name}!
chat.magic.lose.1 = {name}: Não consegui adivinhar! Você me venceu!
chat.magic.lose.2 = {name}: Nossa, essa foi difícil. Você ganhou dessa vez!
chat.magic.lose.3 = {name}: Desisto! Qual era? Você é muito bom nisso!
chat.magic.question.1 = {name}: Pergunta {num}: {question}
chat.magic.question.2 = {name}: Lá vai a pergunta {num}: {question}
chat.magic.question.3 = {name}: Me diz uma coisa (Pergunta {num}): {question}
chat.prof.reject.1 = {name}: Você não é meu chefe! Não vou mudar de profissão só porque você mandou. (Requer 20 de amizade)
chat.prof.reject.2 = {name}: Quem te deu o direito de me dar ordens? Não vou mudar minha profissão! (Requer 20 de amizade)
chat.prof.reject.3 = {name}: Eu gosto do que faço, por que eu mudaria só porque você quer? (Requer 20 de amizade)
chat.prof.accept.1 = {name}: Muito bem, a partir de hoje eu serei um {prof_name}!
chat.prof.accept.2 = {name}: Certo! Pode me chamar de o mais novo {prof_name} da cidade!
chat.prof.accept.3 = {name}: Gostei da ideia. Vou começar a trabalhar como {prof_name} agora mesmo!
chat.prof.invalid.1 = {name}: Não entendi qual profissão você quer que eu tenha. Tente 'vire minerador', 'vire fazendeiro', etc.
chat.prof.invalid.2 = {name}: Que profissão é essa? Seja mais claro, tipo: 'vire minerador'.
chat.prof.invalid.3 = {name}: Hã? Não conheço esse trabalho. Diga algo como 'vire fazendeiro'.
chat.job.wrong_prof.1 = {name}: Desculpe, eu sou um {prof_name} e não sei fazer trabalho de {job_name}!
chat.job.wrong_prof.2 = {name}: Eu não levo jeito pra {job_name}, meu negócio é ser {prof_name}!
chat.job.wrong_prof.3 = {name}: Ué, eu sou {prof_name}, não faço ideia de como se trabalha com {job_name}.
chat.job.reject.1 = {name}: Nós mal nos conhecemos! Eu não vou trabalhar para você de graça. (Requer 10 de amizade)
chat.job.reject.2 = {name}: Tá achando que sou seu empregado? Nem somos amigos direito! (Requer 10 de amizade)
chat.job.reject.3 = {name}: Não vou fazer isso, a gente mal se fala. (Requer 10 de amizade)
chat.job.accept.1 = {name}: Certo, me preparando para ir fazer trabalho de {job_name}!
chat.job.accept.2 = {name}: Beleza, tô indo lá começar meu trampo de {job_name}!
chat.job.accept.3 = {name}: Pode deixar comigo, o trabalho de {job_name} já vai começar.
tick.job.depart.1 = {name}: Estou saindo agora! Volto assim que terminar.
tick.job.depart.2 = {name}: Fui! Logo mais eu tô de volta.
tick.job.depart.3 = {name}: Partiu trabalho! Daqui a pouco eu termino.
tick.job.complete.1 = {name}: Terminei meu trabalho de {job_name} e voltei!
tick.job.complete.2 = {name}: Ufa, acabei o trabalho de {job_name}. Tô de volta!
tick.job.complete.3 = {name}: Missão cumprida! O serviço de {job_name} tá finalizado.
tick.chat.timeout.1 = {name}: Hmm, acho que você está ocupado. Depois nos falamos!
tick.chat.timeout.2 = {name}: Você parece distraído... a gente se fala depois!
tick.chat.timeout.3 = {name}: Já vi que você não tá a fim de papo hoje. Tchau!
cmd.spawn.usage = Uso correto: /simtale spawn [NPCType]
cmd.spawn.error = Erro ao spawnar NPC do tipo {type}.
cmd.spawn.success = NPC do tipo {type} spawnado!
cmd.reload.db = Remontando NPCs do banco de dados...
cmd.here.success = Chamou {count} NPCs para a sua posição!
chat.magic.cancel.1 = {name}: Ah, que pena! A gente joga depois então.
chat.magic.cancel.2 = {name}: Sem problemas, fica pra próxima!
chat.magic.cancel.3 = {name}: Deixamos o jogo pra depois, tudo bem!
chat.magic.invalid.1 = {name}: Não entendi! Responda: Sim (Yes), Não (No), Não sei (Don't know), ou Sair (Quit).
chat.magic.invalid.2 = {name}: Resposta inválida. Tem que ser Sim, Não, Não sei, ou Sair.
chat.magic.invalid.3 = {name}: Hã? Tenta de novo usando Sim, Não, Não sei, ou Sair.
cmd.interact.none = Nenhum NPC vivo por perto!
cmd.interact.success = Forced UI to open for {name}
reaper.soul_taken = §cO tempo de {name} acabou. A Dona Morte levou sua alma.
reaper.tombstone_given = §eVocê guardou um Rock_Stone_Cobble como 'Lápide' de {name}

# FRIENDLY GREETINGS
chat.friendly.greeting.1 = {name} sorri: Olá! Bom te ver por aqui hoje.
chat.friendly.greeting.2 = {name} acena: Ei! Como estão as coisas?
chat.friendly.greeting.3 = {name}: Opa! Alguma novidade em Orbis?
chat.friendly.greeting.4 = {name} sorri de forma amigável: Oi! Fico feliz que você veio conversar.
chat.friendly.greeting.5 = {name}: Olá! Eu já estava me perguntando quando a gente ia se ver de novo.

# TRAIT GREETINGS
chat.greedy.greeting.1 = {name} esfrega as mãos: Você tem algum minério ou item sobrando pra mim hoje?
chat.greedy.greeting.2 = {name} olha pra sua mochila: Hmm, tantas coisas brilhantes aí... não quer compartilhar?
chat.greedy.greeting.3 = {name} pisca: Olá! Veio me trazer presentes ou só jogar conversa fora?
chat.paranoid.greeting.1 = {name} olha ao redor suando frio: Shh! Você ouviu isso?...
chat.paranoid.greeting.2 = {name} sussurra nervoso: Eles estão nos observando... aja naturalmente!
chat.paranoid.greeting.3 = {name} te puxa de lado: Viu aquele arbusto se mexer? Certeza que era um espião Trork.
chat.lazy.greeting.1 = {name} boceja: Ah, oi... Me acorda quando o jantar estiver pronto.
chat.lazy.greeting.2 = {name} se espreguiça: Oi... Que sono. Você disse algo importante?
chat.lazy.greeting.3 = {name} suspira com preguiça: Oi. Se for sobre trabalho, diz que eu não tô.

# CONTEXTUAL GREETINGS
chat.context.bleeding = {name} arregala os olhos: Meu deus, você está sangrando! Precisa de ajuda?!
chat.context.night = {name} sussurra: É perigoso andar por aqui à noite... Tome cuidado.
chat.context.insulted.recent = {name} cruza os braços: O que você quer? Já não me insultou o suficiente hoje?
chat.context.insulted.other = {name} te olha feio: Fiquei sabendo o que você fez com {otherName}. É melhor você andar na linha.
chat.context.missed = {name} arregala os olhos: Nossa, não te vejo há dias! Onde você estava?!

# FUNNY
chat.funny.angry.1 = {name}: ...isso era pra ter graça?
chat.funny.angry.2 = {name} suspira: Não tô de humor pra piadinhas hoje.
chat.funny.angry.3 = {name} te olha seriamente: Me poupe das suas piadas agora, por favor.
chat.funny.angry.4 = {name} balança a cabeça: Sem graça. Muito sem graça.
chat.funny.angry.5 = {name} cruza os braços: Eu com problemas reais aqui e você vem com piada?
chat.funny.trait.1 = {name}: HAHAHA! Boa! Você tem o dom pra comédia.
chat.funny.trait.2 = {name} ri alto: Meu deus, essa foi genial! Vou ter que contar pros outros.
chat.funny.trait.3 = {name} chora de rir: Ai não, para! Minha barriga tá doendo de tanto rir! Hahaha!
chat.funny.trait.4 = {name} te dá um tapinha amigável no ombro: Hahaha, você é uma figura! Adorei!
chat.funny.trait.5 = {name} dá uma gargalhada: Muito boa! Eu sabia que você era engraçado, mas essa superou.
chat.funny.normal.1 = Você contou uma piada! {name} riu bastante.
chat.funny.normal.2 = {name} dá uma risadinha: Heh, essa foi boa. Valeu pelo sorriso.
chat.funny.normal.3 = {name} sorri com humor: Boa tentativa! Essa eu não conhecia.
chat.funny.normal.4 = Você compartilhou uma piada e {name} deu um belo sorriso.
chat.funny.normal.5 = {name} solta um riso abafado: Hahaha, ok, essa foi bonitinha.

# ROMANTIC
chat.romantic.reject.1 = {name}: Cara... que? Sai pra lá.
chat.romantic.reject.2 = {name} te olha com desdém: Menos, bem menos. A gente não tem essa intimidade.
chat.romantic.reject.3 = {name} dá um passo para trás: Por favor, guarde esses comentários pra você.
chat.romantic.reject.4 = {name} cruza os braços revirando os olhos: Acho que você confundiu a pessoa. Me deixe em paz.
chat.romantic.reject.5 = {name} diz friamente: Que cantada barata. Eu não caio nessa.
chat.romantic.shy.1 = {name} cora e desvia o olhar: O-obrigado... você também não é nada mal.
chat.romantic.shy.2 = {name} gagueja vermelho: Ah... E-eu... obrigado. Você me pega de surpresa assim.
chat.romantic.shy.3 = {name} cobre o rosto tímido: P-para de me olhar assim, tá me deixando sem graça!
chat.romantic.shy.4 = {name} dá um sorriso envergonhado: Você sempre diz essas coisas tão de repente... bobo.
chat.romantic.shy.5 = {name} morde o lábio de vergonha: Ah... obrigado pelo elogio. Fico feliz.
chat.romantic.normal.1 = {name}: Heh... continue falando. Tô gostando de ouvir.
chat.romantic.normal.2 = {name} pisca: É mesmo? Quem sabe se você insistir um pouquinho mais...
chat.romantic.normal.3 = {name} dá um sorriso de canto: Olha só, um galanteador por aqui. Interessante.
chat.romantic.normal.4 = {name} sorri confiante: Eu sei que sou incrível, mas é sempre bom ouvir de você.
chat.romantic.normal.5 = {name} dá um sorriso charmoso: Você sabe mesmo como encantar alguém, não é?

# MEAN
chat.mean.aggressive.1 = {name} saca a arma: Você quer resolver isso agora mesmo?!
chat.mean.aggressive.2 = {name} cerra os punhos: Repete isso na minha cara se for homem!
chat.mean.aggressive.3 = {name} te empurra: Quem você acha que é pra falar assim comigo?!
chat.mean.aggressive.4 = {name} grita furioso: Cala a boca antes que eu te faça calar!
chat.mean.aggressive.5 = {name} cospe no chão: Você vai se arrepender de ter aberto essa boca.
chat.mean.needy.1 = {name} quase chora: Por que você é tão malvado comigo? O que eu te fiz?
chat.mean.needy.2 = {name} fica com os olhos cheios d'água: Eu achei que a gente era amigo...
chat.mean.needy.3 = {name} funga magoado: Suas palavras doem muito, sabia?
chat.mean.needy.4 = {name} abaixa a cabeça triste: Não precisava ser tão rude... eu só tava aqui.
chat.mean.needy.5 = {name} diz com a voz trêmula: Eu... eu achei que você fosse uma pessoa melhor.
chat.mean.normal.1 = Você insultou {name}! A conversa ficou extremamente tensa.
chat.mean.normal.2 = {name} te ignora friamente, virando as costas.
chat.mean.normal.3 = {name} te olha com nojo: Você deve ter uma vida bem triste pra falar assim dos outros.
chat.mean.normal.4 = {name} retruca com desdém: Falou o exemplo de pessoa. Olha pro espelho.
chat.mean.normal.5 = {name} responde seco: Eu não perco meu tempo conversando com sua laia.

# GIFT
chat.gift.loves = {name} abre um sorrisão: Meu deus, {itemName}?! Esse é meu favorito! Você me conhece tão bem!
chat.gift.hates = {name} faz careta de nojo: Eca... {itemName}? Eu odeio isso! Você tá tentando me insultar?
chat.gift.trash = {name} franze a testa irritado: {itemName}? Por que você tá me dando lixo?!
chat.gift.greedy = {name} arregala os olhos: Pra mim?! Haha, {itemName}! Finalmente alguém que me valoriza!
chat.gift.paranoid = {name} olha pro presente ({itemName}) com desconfiança: Isso não tá envenenado, né?
chat.gift.normal = {name} sorri: Uau, {itemName}! Muito obrigado pelo presente.

# ASSIGN PROFESSION
chat.prof.assign.unknown = {name} olha confuso pro {itemName}: ...e o que eu faço com isso? Isso não é ferramenta de trabalho!
chat.prof.assign.already = {name}: Eu já sou um {profName}, esqueceu? Tô trampando nisso todo dia!
chat.prof.assign.dislike.1 = {name} faz cara de nojo: {profName}?! Nem morto! Eu detesto esse tipo de trabalho!
chat.prof.assign.dislike.2 = {name} cruza os braços: Não, valeu. {profName} não é pra mim. Eu odeio.
chat.prof.assign.dislike.3 = {name} empurra o {itemName} de volta: Tá brincando? Eu odiaria ser um {profName}!
chat.prof.assign.dislike.4 = {name} balança a cabeça: Sem chance. {profName} é a última coisa que eu quero ser.
chat.prof.assign.lazy.1 = {name} boceja: {profName}? Isso dá muito trabalho... não tenho energia pra isso.
chat.prof.assign.lazy.2 = {name} se espreguiça: Trabalho pesado? Eu? Hahaha, boa piada.
chat.prof.assign.lazy.3 = {name} suspira: Olha, valeu pela oferta, mas... não dá não. Envolve muito suor.
chat.prof.assign.aggressive.1 = {name} rosna: {profName}?! Eu tenho cara de quem planta florzinha?!
chat.prof.assign.aggressive.2 = {name} bate no peito: Eu sou um guerreiro, não um plebeu! Me respeite!
chat.prof.assign.aggressive.3 = {name} cospe no chão: Trabalho pacato demais pra mim. Me dê algo com ação!
chat.prof.assign.angry.1 = {name} grita: NÃO TÔ DE HUMOR PRA ISSO! Volta depois!
chat.prof.assign.angry.2 = {name} te olha irritado: Agora não! Tô puto demais pra pensar em emprego!
chat.prof.assign.angry.3 = {name} empurra o item longe: Me deixa em paz! Não vem com propostas agora!
chat.prof.assign.return = {name} te devolve as ferramentas de {profName}. 
chat.prof.assign.liked.1 = {name} pega o {itemName} com os olhos brilhando: {profName}?! Eu SEMPRE quis fazer isso! Obrigado!
chat.prof.assign.liked.2 = {name} quase pula de alegria: Sério, eu vou ser um {profName}?! Esse é meu sonho!
chat.prof.assign.liked.3 = {name} abraça o {itemName}: Finalmente alguém reconhece meu talento! Serei o melhor {profName} de todos!
chat.prof.assign.accept.1 = {name} pega o {itemName} e assente: Ok, {profName} parece bom. Vou dar meu melhor!
chat.prof.assign.accept.2 = {name} examina o {itemName}: Hmm, {profName}... Eu posso tentar. Valeu pela oportunidade!
chat.prof.assign.accept.3 = {name} sorri: {profName}? Claro! Vou começar agora mesmo.
chat.prof.assign.accept.4 = {name} guarda o {itemName}: Beleza, eu aceito ser um {profName}. Pode contar comigo!
chat.prof.assign.accept.5 = {name} testa o {itemName}: Nunca trabalhei com isso, mas tô empolgado pra aprender!

