simtale.chat.busy_multiplayer = <%name%> Desculpe, estou conversando com outra pessoa no momento.
simtale.chat.cancel = <%name%> Tudo bem, até mais! Se precisar é só chamar.
simtale.chat.magic.start = <%name%> Oba! Vamos jogar MagicGinn. Pense em um animal e me responda com Sim (Yes) ou Não (No).
simtale.chat.magic.reject = <%name%> Nós não somos tão próximos para eu brincar com você.
simtale.chat.busy_job = <%name%> Já estou ocupado com meu trabalho de %job%!
simtale.chat.come = <%name%> Estou indo!
simtale.chat.greeting.1 = <%name%> Opa, chamou? Precisando de algo? (Diga 'pescar', 'minerar', etc)
simtale.chat.greeting.2 = <%name%> Fala tu! Qual a boa de hoje? (Diga 'pescar', 'minerar', etc)
simtale.chat.greeting.3 = <%name%> Oi! Tem alguma missão pra mim? (Diga 'pescar', 'minerar', etc)
simtale.chat.greeting.4 = <%name%> Estou aqui. O que quer que eu faça? (Diga 'pescar', 'minerar', etc)
simtale.chat.greeting.5 = <%name%> Ei! Pronto pro trabalho. Diga o que precisa. (Diga 'pescar', 'minerar', etc)
simtale.chat.smalltalk.1 = <%name%> Haha, não saquei o que você disse, mas o dia tá bonito hoje né?
simtale.chat.smalltalk.2 = <%name%> Hmm... quer que eu faça alguma coisa ou só tá jogando conversa fora?
simtale.chat.smalltalk.3 = <%name%> Tendi nada... Se quiser que eu trabalhe, fala a ação direto, tipo 'minerar' ou 'farmar'.
simtale.chat.smalltalk.4 = <%name%> O que? Desculpa, tava pensando na vida. O que era pra fazer?
simtale.chat.smalltalk.5 = <%name%> Interessante... mas não entendi. Tem alguma tarefa pra mim?
simtale.chat.magic.win = <%name%> Eu já sei! O animal que você pensou é: %animal_name%!
simtale.chat.magic.lose = <%name%> Não consegui adivinhar! Você me venceu!
simtale.chat.magic.question = <%name%> Pergunta %num%: %question%
simtale.chat.prof.reject = <%name%> Você não é meu chefe! Não vou mudar de profissão só porque você mandou. (Requer 20 de amizade)
simtale.chat.prof.accept = <%name%> Muito bem, a partir de hoje eu serei um %prof_name%!
simtale.chat.prof.invalid = <%name%> Não entendi qual profissão você quer que eu tenha. Tente 'vire minerador', 'vire fazendeiro', etc.
simtale.chat.job.wrong_prof = <%name%> Desculpe, eu sou um %prof_name% e não sei fazer trabalho de %job_name%!
simtale.chat.job.reject = <%name%> Nós mal nos conhecemos! Eu não vou trabalhar para você de graça. (Requer 10 de amizade)
simtale.chat.job.accept = <%name%> Certo, me preparando para ir fazer trabalho de %job_name%!

simtale.tick.job.depart = <%name%> Estou saindo agora! Volto assim que terminar.
simtale.tick.job.complete = <%name%> Terminei meu trabalho de %job_name% e voltei!
simtale.tick.chat.timeout = <%name%> Hmm, acho que você está ocupado. Depois nos falamos!

simtale.cmd.spawn.usage = Uso correto: /simtale spawn [NPCType]
simtale.cmd.spawn.error = Erro ao spawnar NPC do tipo %type%.
simtale.cmd.spawn.success = NPC do tipo %type% spawnado!
simtale.cmd.reload.db = Remontando NPCs do banco de dados...
simtale.cmd.here.success = Chamou %count% NPCs para a sua posição!
simtale.chat.magic.cancel = <%name%> Ah, que pena! A gente joga depois então.
simtale.chat.magic.invalid = <%name%> Não entendi! Responda: Sim (Yes), Não (No), Não sei (Don't know), ou Sair (Quit).
simtale.cmd.interact.none = Nenhum NPC vivo por perto!
simtale.cmd.interact.success = Forced UI to open for %name%
