young.proximity.own_teen.5 = *sonríe a medias* Hola. Me alegra verte, pero no le digas a nadie que lo dije.
young.proximity.own_teen.6 = *apenas levanta la mirada* Hola.
young.proximity.own_teen.7 = Ah. Eres tú. Hola.
young.proximity.own_teen.8 = {parent}. —pausa— ...hola.
young.proximity.own_teen.9 = *deja de hacer lo que hacía* Ah. Hola, {parent}.
young.proximity.own_adult.1 = ¡HOLA, {parent}! ME ALEGRA VERTE.
young.proximity.own_adult.2 = ¡{parent}! VEN, HACE TIEMPO QUE NO HABLAMOS DE VERDAD.
young.proximity.own_adult.3 = *sonríe* Hola, {parent}. ¿Cómo estás?
young.proximity.own_adult.4 = ¡HOLA, {parent}! JUSTO ESTABA PENSANDO EN TI HOY.
young.proximity.own_adult.5 = Hola, {parent}. Siempre es bueno tenerte cerca.
young.proximity.own_adult.6 = *saluda con la mano* Hola, {parent}. Qué bueno verte por aquí.
young.proximity.own_adult.7 = ¡{parent}! ESPERABA QUE VINIERAS.
young.proximity.own_adult.8 = Hola. ¿Cómo va tu día hasta ahora?
young.proximity.own_adult.9 = *sonríe levemente* {parent}. Siempre es buen momento para detenerse a conversar.

# NPC-NPC CONTEXTUAL SOCIAL DIALOGUES
social.hostile.1.a = {name}: ¡QUÍTATE DE MI VISTA! ¡NO QUIERO HABLAR CONTIGO!
social.hostile.1.b = {name}: ¡NO ABUSES DE TU SUERTE! ¡TE ARREPENTIRÁS DE BUSCAR PELEA CONMIGO!
social.hostile.2.a = {name}: ¿QUÉ MIRAS? ¡LÁRGATE!
social.hostile.2.b = {name}: ¿Quién te crees que eres para darme órdenes?

social.romantic.1.a = {name}: ¡MI AMOR! QUÉ MARAVILLA VERTE AQUÍ.
social.romantic.1.b = {name}: Mi día siempre mejora en cuanto veo tu rostro.
social.romantic.2.a = {name}: Justo estaba pensando en ti...
social.romantic.2.b = {name}: ¿De verdad? No me separaría de tu lado por nada del mundo.
social.romantic.3.a = {name}: El otro día me descubrí pensando en cuando nos conocimos.
social.romantic.3.b = {name}: Ay, qué dulce... A veces yo también pienso en eso.

social.hunger.1.a = {name}: Me ruge el estómago... Pronto tendré que buscar algo para comer.
social.hunger.1.b = {name}: ¡NI QUE LO DIGAS! SI NO CONSIGO COMIDA PRONTO, PODRÍA DESMAYARME.
social.hunger.2.a = {name}: ¿Has visto algún tentempié o un guiso por aquí? Me muero de hambre.
social.hunger.2.b = {name}: CREO QUE OLÍ ALGO COCINÁNDOSE HACE UN RATO. ¡VE A MIRAR POR ALLÁ!

social.fatigue.1.a = {name}: Me pesan muchísimo los párpados... Estoy agotado.
social.fatigue.1.b = {name}: Yo apenas puedo mantenerme en pie. Ya quiero llegar a la cama.
social.fatigue.2.a = {name}: Hoy trabajé demasiado; me está matando la espalda.
social.fatigue.2.b = {name}: Deberías descansar un poco antes de esforzarte demasiado.

social.work.farm.1.a = {name}: Los cultivos van muy bien; tendremos una cosecha abundante.
social.work.farm.1.b = {name}: ¡QUÉ BUENAS NOTICIAS! LA TIERRA DE POR AQUÍ ES EXTRAORDINARIAMENTE FÉRTIL.
social.work.farm.2.a = {name}: Debo regar y cuidar los campos antes de que el sol suba demasiado.
social.work.farm.2.b = {name}: ¡BUENA SUERTE! LA ALDEA AGRADECE LA COSECHA FRESCA.

social.work.wood.1.a = {name}: PASÉ LA MAÑANA CORTANDO TRONCOS. ¡LA MADERA DE AQUÍ ES RESISTENTE!
social.work.wood.1.b = {name}: ¡EXCELENTE! NECESITAREMOS MUCHA LEÑA Y MADERA PARA CONSTRUIR.
social.work.wood.2.a = {name}: Mi hacha se está desafilando de tanto cortar troncos secos.
social.work.wood.2.b = {name}: Ten cuidado de no lastimarte; conseguir buena madera requiere trabajo constante.

social.work.guard.1.a = {name}: La patrulla ha estado tranquila. No hay bestias hostiles cerca de los límites.
social.work.guard.1.b = {name}: De todos modos, es bueno mantenerse alerta. Nunca sabes qué hay en el bosque.
social.work.guard.2.a = {name}: Mantener a salvo este asentamiento es nuestro deber más importante.
social.work.guard.2.b = {name}: Todos descansamos más tranquilos sabiendo que estás vigilando.

social.work.fish.1.a = {name}: ¡HOY LOS PECES ESTÁN PICANDO MUCHO JUNTO AL ARROYO!
social.work.fish.1.b = {name}: ¡FANTÁSTICO! ESTA NOCHE VENDRÍA DE MARAVILLA UNA CENA DE PESCADO FRESCO A LA PARRILLA.
social.work.fish.2.a = {name}: El agua estaba tranquila esta mañana, perfecta para lanzar el anzuelo.
social.work.fish.2.b = {name}: La pesca parece un trabajo tan tranquilo y relajante...

social.mood.happy.1.a = {name}: ¡HOY ME DESPERTÉ CON UNA ENERGÍA MARAVILLOSA! TODO PARECE MÁS BRILLANTE.
social.mood.happy.1.b = {name}: ¡PUEDO VER TU SONRISA DESDE MUY LEJOS! ES CONTAGIOSA.
social.mood.happy.2.a = {name}: Hay días en que la vida en la aldea se siente realmente tranquila.
social.mood.happy.2.b = {name}: ¡ES VERDAD! QUÉ SUERTE VIVIR EN UN PUEBLO TAN AGRADABLE.

social.mood.sad.1.a = {name}: Hoy no ha sido un día fácil... Me siento algo desanimado.
social.mood.sad.1.b = {name}: Siento oír eso. Siempre estoy aquí si necesitas hablar, amigo.
social.mood.sad.2.a = {name}: A veces todo se siente muy pesado, ¿sabes?
social.mood.sad.2.b = {name}: Sé cómo se siente. Ánimo, pronto las cosas mejorarán.

social.night.1.a = {name}: Anocheció muy rápido... Es bastante peligroso andar a oscuras.
social.night.1.b = {name}: Totalmente. Mejor quédate cerca de las antorchas y entra pronto.
social.night.2.a = {name}: Las sombras de aquí por la noche me inquietan un poco.
social.night.2.b = {name}: Asegúrate de cerrar bien las puertas antes de dormir.

social.weather.1.a = {name}: El clima de hoy es agradable, ni demasiado frío ni demasiado caliente.
social.weather.1.b = {name}: ¡DE ACUERDO! ES UN DÍA PERFECTO PARA SALIR A CAMINAR.
social.weather.2.a = {name}: Hoy sopla una brisa muy suave entre los árboles.
social.weather.2.b = {name}: ¡QUÉ BRISA TAN REFRESCANTE!

social.village.1.a = {name}: Nuestra aldea se ve cada día más animada y bonita.
social.village.1.b = {name}: ¡ES VERDAD! ES MARAVILLOSO VER A TODOS OCUPADOS Y VIVIENDO EN PAZ.
social.village.2.a = {name}: Cuando termine mis tareas diarias, daré un largo paseo por el pueblo.
social.village.2.b = {name}: ¡SI TERMINO MIS TAREAS A TIEMPO, TE ACOMPAÑARÉ!

social.child_play.1.a = {name}: ¡JUGUEMOS A ATRAPARNOS! ¡CONTARÉ HASTA DIEZ!
social.child_play.1.b = {name}: ¡ESTA VEZ TE ATRAPARÉ RAPIDÍSIMO!
social.child_play.2.a = {name}: Oye, hoy encontré un insecto nuevo. ¿Quieres verlo?
social.child_play.2.b = {name}: ¡OH, DÉJAME VERLO! ¿PICA?

# CHILD PLAY: tag and hide-and-seek between children (lines said during the game itself, not in
# response to the player -- see playing.* referenced by ChildPlayHelper/RoutineAISystem)
# No {name} embedded -- the caller already prefixes "NpcName: " externally, same as proximity.*.
playing.tag_start.1 = ¡A QUE NO ME ATRAPAS!
playing.tag_start.2 = ¡JUGUEMOS A ATRAPARNOS! ¡CONTARÉ HASTA TRES!
playing.tag_start.3 = ¡CORRE, CORRE! ¡A ATRAPARNOS!
playing.tag_chasing.1 = ¡VOY A ATRAPARTE, VOY A ATRAPARTE!
playing.tag_chasing.2 = ¡ESTA VEZ NO ESCAPARÁS!
playing.tag_chasing.3 = ¿DÓNDE ESTÁS, DÓNDE... ¡AH, AHÍ ESTÁS!
playing.tag_fleeing.1 = ¡NO PUEDES ATRAPARME, NO PUEDES ATRAPARME!
playing.tag_fleeing.2 = ¡TODAVÍA NO! ¡CORRE, CORRE!
playing.tag_fleeing.3 = ¡POR POCO, PERO FALLASTE!
playing.tag_tagged.1 = ¡TE TOCA ATRAPARME!
playing.tag_tagged.2 = ¡AHORA TE PASO LA PAPA CALIENTE!
playing.tag_end.1 = ¡UF, ESTOY CANSADO! ¡FUE MUY DIVERTIDO!
playing.tag_end.2 = ¿JUGAMOS OTRA VEZ DESPUÉS? ¡ME ENCANTÓ!
playing.hideseek_start.1 = ¡JUGUEMOS A LAS ESCONDIDAS! CONTARÉ HASTA DIEZ; ¡VE A ESCONDERTE!
playing.hideseek_start.2 = ¡A LAS ESCONDIDAS! CIERRA LOS OJOS; VOY A BUSCAR UN LUGAR.
playing.hideseek_hiding.1 = Shhh... ¿me encontrará aquí?
playing.hideseek_hiding.2 = Encontré un escondite buenísimo, ¿verdad?
playing.hideseek_hiding.3 = No hagas ruido... silencio...
playing.hideseek_seeking.1 = Uno, dos, tres... ¿dónde estás?
playing.hideseek_seeking.2 = ¡VOY A ENCONTRARTE! ¿ADÓNDE SE HABRÁ IDO...?
playing.hideseek_seeking.3 = HMM, ¿DETRÁS DEL ÁRBOL? NO... ¡VOY A MIRAR POR ALLÁ!
playing.hideseek_found.1 = ¡TE ENCONTRÉ!
playing.hideseek_found.2 = ¡TE ENCONTRÉ! ¡AHORA TE TOCA BUSCAR!
playing.hideseek_end.1 = ¡FUE MUY DIVERTIDO ESCONDERME! ¡HAY QUE REPETIRLO ALGÚN DÍA!
playing.hideseek_end.2 = ¡ERES MUY BUENO ESCONDIÉNDOTE! ¡CASI NO TE ENCUENTRO!

npc_marriage.announce = {name} SONRÍE DE OREJA A OREJA, TOMANDO LA MANO DE {partner}: ¡NOS CASAMOS! TODO OCURRIÓ MUY RÁPIDO, PERO SE SIENTE BIEN.

# WORLD EVENT COMMENTARY (docs/ROADMAP.md: "comentários sobre eventos do mundo")
# No {name} embedded -- the caller already prefixes "NpcName: " externally, same as proximity.*.
world_event.guard_victory.1 = ¡UN PELIGRO MENOS POR AQUÍ!
world_event.guard_victory.2 = ¡ESO FUE POR LA ALDEA!
world_event.guard_victory.3 = Nadie amenazará estas tierras mientras yo esté de guardia.
world_event.guard_victory_witness.1 = ¡VAYA, ¿VISTE ESO?! ¡EL GUARDIA FUE INCREÍBLE!
world_event.guard_victory_witness.2 = FUE ATERRADOR... ¡PERO EL GUARDIA SALVÓ A TODOS!
world_event.guard_victory_witness.3 = ¡FUE COMO VER A UN HÉROE DE VERDAD!
world_event.kweebec_sighted.1 = ¡MIRA, UN KWEEBEC! HACE TIEMPO QUE NO VEO UNO CERCA DE LA ALDEA.
world_event.kweebec_sighted.2 = Psst, hay un Kweebec asomándose por allá. Qué criatura tan curiosa.
world_event.kweebec_sighted.3 = Otro Kweebec por aquí... les encanta recorrer esta zona.
