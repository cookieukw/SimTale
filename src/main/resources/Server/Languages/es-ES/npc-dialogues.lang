carry.nobody = No llevas a nadie en brazos.
carry.picked_up = Levantas a {name} sobre tus hombros.
carry.put_down = Vuelves a dejar a {name} en el suelo.
carry.already = Ya están cargando a {name}.
carry.hint = Agáchate y haz clic en un bloque para bajarlo. Si no funciona, usa /simtale putdown.
carry.stackFull = Solo puedes cargar a {count} a la vez.
carry.stacked = {name} se sube encima de quienes ya llevas cargados.

# Lines spoken by NPCs outside the interaction panel: leaving for work, coming back,
# giving up on a conversation, and the spouse handing the baby over. Moved out of
# general.lang, which is for system messages — these are a character speaking.
tick.job.depart.1 = {name}: ¡ME VOY! ¡VOLVERÉ EN CUANTO TERMINE!
tick.job.depart.2 = {name}: ¡ME MARCHO! VOLVERÉ MÁS TARDE.
tick.job.depart.3 = {name}: ¡ME VOY A TRABAJAR! TERMINARÉ PRONTO.
tick.job.complete.1 = {name}: ¡TERMINÉ MI TRABAJO DE {job_name} Y YA REGRESÉ!
tick.job.complete.2 = {name}: UF, TERMINÉ EL TRABAJO DE {job_name}. ¡YA ESTOY DE VUELTA!
tick.job.complete.3 = {name}: ¡MISIÓN CUMPLIDA! EL TRABAJO DE {job_name} ESTÁ TERMINADO.
tick.chat.timeout.1 = {name}: HMM, CREO QUE ESTÁS OCUPADO. ¡HABLEMOS MÁS TARDE!
tick.chat.timeout.2 = {name}: PARECES DISTRAÍDO... ¡PODEMOS HABLAR DESPUÉS!
tick.chat.timeout.3 = {name}: VEO QUE HOY NO TIENES GANAS DE CONVERSAR. ¡ADIÓS!
baby.custody.spouse_reject = <{spouse}> Ahora te toca cuidar de {name} durante un rato.

# Lines for the baby you are carrying. They live here rather than in general.lang
# because they are a character speaking; general.lang is for system messages.
baby.babble.1 = EL BEBÉ EN TUS BRAZOS: ¡GU... GU-GU... ¡GA-GA!
baby.babble.2 = El bebé se ríe y te agarra un dedo.
baby.babble.3 = EL BEBÉ: ¡AAAAA-BUUU!
baby.babble.4 = El bebé bosteza lentamente y se acomoda.
baby.babble.5 = El bebé hace una burbuja con la saliva y parece encantado consigo mismo.
baby.babble.6 = EL BEBÉ: ¿DA-DA? ¡DA-DA!
baby.babble.7 = El bebé te mira fijamente y en silencio durante un rato incómodo. Luego sonríe.
baby.babble.8 = El bebé gimotea suavemente y se calma en cuanto lo meces un poco.

friendly.greeting.1 = {name} SONRÍE: ¡HOLA! QUÉ BUENO VERTE POR AQUÍ HOY.
friendly.greeting.2 = {name} SALUDA CON LA MANO: ¡HOLA! ¿CÓMO VAN LAS COSAS?
friendly.greeting.3 = {name}: ¡HOLA! ¿HAY NOTICIAS EN ORBIS?
friendly.greeting.4 = {name} SONRÍE CON AMABILIDAD: ¡HOLA! ME ALEGRA QUE HAYAS VENIDO A CONVERSAR.
friendly.greeting.5 = {name}: Hola. Justo me preguntaba cuándo volveríamos a vernos.
greedy.greeting.1 = {name} se frota las manos: ¿Tienes minerales u objetos de sobra para mí hoy?
greedy.greeting.2 = {name} mira tu mochila: Hmm, tienes tantas cosas brillantes... ¿no quieres compartir?
greedy.greeting.3 = {name} GUIÑA UN OJO: ¡HOLA! ¿VINISTE A TRAERME REGALOS O SOLO A CHARLAR?
paranoid.greeting.1 = {name} MIRA A SU ALREDEDOR, SUDANDO FRÍO: ¡SHHH! ¿OÍSTE ESO?...
paranoid.greeting.2 = {name} SUSURRA CON NERVIOSISMO: NOS ESTÁN VIGILANDO... ¡ACTÚA CON NATURALIDAD!
paranoid.greeting.3 = {name} te aparta: ¿Viste moverse ese arbusto? Seguro que era un espía trork.
lazy.greeting.1 = {name} bosteza: Ah, hola... Despiértame cuando esté lista la cena.
lazy.greeting.2 = {name} se estira: Hola... Tengo mucho sueño. ¿Dijiste algo importante?
lazy.greeting.3 = {name} suspira con pereza: Hola. Si es por trabajo, diles que no estoy.
context.bleeding = {name} ABRE MUCHO LOS OJOS: ¡DIOS MÍO, ESTÁS SANGRANDO! ¿NECESITAS AYUDA?
context.night = {name} susurra: Es peligroso andar por aquí de noche... Ten cuidado.
context.insulted.recent = {name} cruza los brazos: ¿Qué quieres? ¿No te bastó con insultarme hoy?
context.insulted.other = {name} te mira con enojo: Me enteré de lo que le hiciste a {otherName}. Más te vale portarte bien.
context.attacked.recent = {name} RETROCEDE CON MIEDO: ¡ALÉJATE DE MÍ! ¡ME ATACASTE!
context.attacked.other = {name} TE MIRA CON DESCONFIANZA: ME ENTERÉ DE QUE ATACASTE A {otherName}... ¡ALÉJATE DE MÍ!
context.missed = {name} ABRE MUCHO LOS OJOS: ¡VAYA, NO TE HE VISTO EN DÍAS! ¿DÓNDE ESTABAS?
funny.angry.1 = {name}: ...¿Se suponía que eso debía dar risa?
funny.angry.2 = {name} suspira: Hoy no tengo ganas de bromas.
funny.angry.3 = {name} te mira con seriedad: Por favor, ahórrame tus bromas por ahora.
funny.angry.4 = {name} niega con la cabeza: Sin gracia. Muy, muy sin gracia.
funny.angry.5 = {name} cruza los brazos: Tengo problemas de verdad y vienes a contarme chistes.
funny.trait.1 = {name}: ¡JAJAJA! ¡BUENÍSIMO! SE TE DA MUY BIEN HACER REÍR.
funny.trait.2 = {name} SE RÍE A CARCAJADAS: ¡DIOS MÍO, FUE GENIAL! TENGO QUE CONTÁRSELO A LOS DEMÁS.
funny.trait.3 = {name} SE RÍE HASTA LLORAR: ¡NO, BASTA! ¡ME DUELE EL ESTÓMAGO DE TANTO REÍR! ¡JAJAJA!
funny.trait.4 = {name} TE DA UNA PALMADA AMISTOSA EN EL HOMBRO: ¡JAJAJA, ERES TODO UN PERSONAJE! ¡ME ENCANTÓ!
funny.trait.5 = {name} SUELTA UNA CARCAJADA: ¡MUY BUENO! SABÍA QUE ERAS GRACIOSO, PERO ESTO SUPERÓ TODO.
funny.normal.1 = Contaste un chiste. {name} se rio muchísimo.
funny.normal.2 = {name} suelta una risita: Je, estuvo bueno. Gracias por hacerme sonreír.
funny.normal.3 = {name} SONRÍE CON HUMOR: ¡BUEN INTENTO! NO HABÍA ESCUCHADO ESE ANTES.
funny.normal.4 = Compartiste un chiste divertido y {name} te dedicó una hermosa sonrisa.
funny.normal.5 = {name} suelta una risa ahogada: Jajaja, está bien, fue bastante tierno.
romantic.reject.1 = {name}: Amigo... ¿qué? Vete.
romantic.reject.2 = {name} te mira con desprecio: Mucho menos, muchísimo menos. No tenemos tanta confianza.
romantic.reject.3 = {name} da un paso atrás: Por favor, guárdate esos comentarios.
romantic.reject.4 = {name} cruza los brazos y pone los ojos en blanco: Te equivocaste de persona. Déjame en paz.
romantic.reject.5 = {name} dice con frialdad: Qué frase tan barata para ligar. No caigo en eso.
romantic.shy.1 = {name} se sonroja y mira hacia otro lado: G-gracias... tú tampoco estás nada mal.
romantic.shy.2 = {name}, roja de vergüenza, tartamudea: Ah... y-yo... gracias. Me tomaste por sorpresa.
romantic.shy.3 = {name} SE CUBRE EL ROSTRO CON TIMIDEZ: ¡D-DEJA DE MIRARME ASÍ, ME HACES SENTIR INCÓMODO!
romantic.shy.4 = {name} sonríe con vergüenza: Siempre dices esas cosas de repente... tontito.
romantic.shy.5 = {name} se muerde el labio con timidez: Ah... gracias por el cumplido. Me hace feliz.
romantic.normal.1 = {name}: Je... sigue hablando. Me gusta escucharte.
romantic.normal.2 = {name} guiña un ojo: ¿De verdad? Quién sabe, tal vez si insistes un poco más...
romantic.normal.3 = {name} sonríe con picardía: Vaya, tenemos a alguien encantador por aquí. Interesante.
romantic.normal.4 = {name} sonríe con confianza: Sé que soy increíble, pero siempre es bueno escucharlo de ti.
romantic.normal.5 = {name} te dedica una sonrisa encantadora: Sabes cómo conquistar a alguien, ¿verdad?
kiss.success.1 = {name} cierra los ojos y te devuelve el beso con ternura.
kiss.success.2 = {name} sonríe en medio del beso, con el corazón acelerado.
kiss.success.3 = {name} se acerca más, perdido en el momento.
kiss.reject = {name} aparta el rostro: Todavía no tenemos tanta confianza...
young.chat.village_child.1 = {name} te mira desde abajo: Eres ENORME. ¿Alguna vez fuiste pequeño?
young.chat.village_child.2 = {name}: Mi mamá me dijo que no hablara con desconocidos. Pero pareces buena persona.
young.chat.village_child.3 = {name} SEÑALA EL CIELO: ¡MIRA ESE PÁJARO! ¿VIVE ALLÁ ARRIBA?
young.chat.village_child.4 = {name}: Hoy encontré una piedra. Es mi piedra favorita.
young.chat.village_child.5 = {name} CORRE DOS VECES A TU ALREDEDOR Y SE DETIENE SIN ALIENTO: ¡HOLA!
young.chat.village_child.6 = {name}: ¿Sabías que si das vueltas muy rápido te mareas? Ya lo probé.
young.chat.village_child.7 = {name} HUELE UNA FLOR Y ESTORNUDA: ¡ACHÍS! ESA ERA MÁS FUERTE DE LO QUE ESPERABA.
young.chat.village_child.8 = {name} MIRA TUS ZAPATOS: ¡SON ENORMES! SEGURO QUE MI PIE ENTERO CABE DENTRO DE UNO.
young.chat.village_child.9 = {name}: ¡PUEDO CONTAR HASTA CIEN SIN EQUIVOCARME! ¿QUIERES VER? UNO, DOS, TRES...
young.chat.village_child.10 = {name} TIRA DE TU MANGA: ¡VAMOS, VAMOS! ¡HAY UNA RANA ENORME JUNTO AL POZO, LA VI!
young.chat.village_child.11 = {name} PRESUME DE UNA RODILLA RASPADA: ME CAÍ DEL ÁRBOL, ¡PERO CASI ALCANCÉ LA RAMA!
young.chat.village_child.12 = {name}: Si me quedo muy quieto, los pájaros se acercan mucho. ¡Tú también guarda silencio.

young.chat.own_child.1 = {name} TIRA DE TU MANGA: {parent}, ¡MIRA ESE PÁJARO! ¡ME ESTÁ MIRANDO!
young.chat.own_child.2 = {name}: Cuando crezca, quiero ser como tú. Pero más alto.
young.chat.own_child.3 = {name} LEVANTA SUS DOS MANOS LLENAS DE BARRO: ¡MIRA LO QUE ENCONTRÉ! ES UN INSECTO. LE PONDRÉ UN NOMBRE.
young.chat.own_child.4 = {name}: ¿Volverás antes de que oscurezca? No me gusta que esté oscuro y tú no estés aquí.
young.chat.own_child.5 = {name} abraza tu pierna y se queda en silencio un rato.
young.chat.own_child.6 = {name}: {parent}, ¿puedo acostarme un poquito más tarde hoy? ¿Solo un rato?
young.chat.own_child.7 = {name} dibuja algo en el suelo con un palo: Mira, ese soy yo. Y ese eres tú, {parent}.
young.chat.own_child.8 = {name} tira de tu mano: {parent}, ¿puedes quedarte un poquito más? Solo un ratito.
young.chat.own_child.9 = {name}: Les dije a mis amigos que eres la persona más fuerte de la aldea. Espero que sea verdad.
young.chat.own_child.10 = {name} esconde algo detrás de la espalda: Hice esto para ti, {parent}. No es bonito, pero es tuyo.
young.chat.own_child.11 = {name}: {parent}, ¿hay algo que te dé miedo? A mí sí, y quería saber si se te pasa al crecer.
young.chat.own_child.12 = {name}, bostezando pero resistiéndose al sueño: No tengo sueño, {parent}. Lo juro... y se queda dormido de pie.

young.chat.own_teen.1 = {name} se encoge de hombros: Hola. Estoy bien, puedes dejar de preguntar.
young.chat.own_teen.2 = {name}: Puedo cuidarme, ¿sabes? Ya no soy un niño.
young.chat.own_teen.3 = {name} mira hacia otro lado: ...Te vi al otro lado de la aldea hoy. No te dije nada porque había gente.
young.chat.own_teen.4 = {name}: Este lugar es demasiado pequeño. Algún día quiero ver qué hay al otro lado.
young.chat.own_teen.5 = {name} casi sonríe: Está bien. Fue agradable tenerte cerca hoy. No se lo digas a nadie.
young.chat.own_teen.6 = {name}: Está bien, lo admito. Me alegró verte hoy. Pero no volveré a decirlo.
young.chat.own_teen.7 = {name} se apoya en la pared, más serio de lo normal: A veces quisiera... no sé. Volver a ser pequeño.
young.chat.own_teen.8 = {name}: No, no quiero hablar de «sentimientos». Solo vine a saludar.
young.chat.own_teen.9 = {name} mueve el pie contra el suelo: No vine a hablar de nada importante. Solo... estaba por aquí.
young.chat.own_teen.10 = {name}: A veces los escucho hablar por la noche. Es extraño pensar que algún día yo diré esas cosas.
young.chat.own_teen.11 = {name} cruza los brazos, pero se queda: No vine a buscarte. Fue una coincidencia.
young.chat.own_teen.12 = {name}: ¿Sabías que algunos de mi edad ya se fueron de la aldea? Yo no me iría, solo... lo pienso a veces.

young.chat.own_adult.1 = {name} te saluda con un gesto: Todo bien por aquí. ¿Te estás cuidando?
young.chat.own_adult.2 = {name}: ¿Recuerdas cuando era pequeño y creía que aquella colina era el fin del mundo?
young.chat.own_adult.3 = {name} sonríe: He empezado a hablar como tú. Me di cuenta el otro día y me aterró.
young.chat.own_adult.4 = {name}: Si alguna vez necesitas algo, solo dímelo. Lo digo en serio.
young.chat.own_adult.5 = {name}: Estoy construyendo mi vida aquí. Al final, todo salió bien.
young.chat.own_adult.6 = {name}: Me alegra que hayas venido. De todos modos, pensaba ir a buscarte más tarde.
young.chat.own_adult.7 = {name} mira a su alrededor: La aldea ha crecido mucho desde que era pequeño. Es extraño, pero para bien.
young.chat.own_adult.8 = {name}: ¿Sabes que todavía recuerdo todas las historias que me contabas? Las guardé todas.
young.chat.own_adult.9 = {name} mira sus propias manos: Qué curioso, tengo tus manos. Me di cuenta hace poco.
young.chat.own_adult.10 = {name}: Si algún día tengo un hijo, espero poder hacer al menos la mitad de lo que hiciste por mí.
young.chat.own_adult.11 = {name} se ríe para sí: Estaba recordando alguna tontería que hacía de niño. ¿Te acuerdas?
young.chat.own_adult.12 = {name}: No sé si te lo he dicho alguna vez, pero... gracias. De verdad, por todo.

young.joke.village_child.1 = {name} se echa a reír y no puede parar. Ni siquiera era tan gracioso.
young.joke.village_child.2 = {name} se ríe e intenta contártelo de vuelta enseguida, arruinando el final.
young.joke.village_child.3 = {name} SE QUEDA SIN ALIENTO: ¡VOY A CONTARLE ESE CHISTE A MI MAMÁ!
young.joke.village_child.4 = {name} se ríe tanto que le da hipo.
young.joke.village_child.5 = {name}: NO LO ENTIENDO. —PAUSA— ¡OH! ¡YA LO ENTIENDO! —Y SE RÍE A SOLAS.
young.joke.village_child.6 = {name} TE SEÑALA ENTRE RISAS: ¡REPÍTELO! ¡REPÍTELO!
young.joke.village_child.7 = {name} intenta contener la risa, pero fracasa por completo y termina riéndose con la nariz moqueando.
young.joke.village_child.8 = {name} se ríe tan fuerte que asusta a un pájaro cercano.
young.joke.village_child.9 = {name}: ¡ESPERA, VOY A CONTARLES ESE A MIS AMIGOS! —SALE CORRIENDO ANTES DE QUE RESPONDAS.
young.joke.village_child.10 = {name} SE SEÑALA LA BARRIGA: ¡ME DUELE DE TANTO REÍR! ¡PERO SIGUE, SIGUE!
young.joke.village_child.11 = {name} se ríe tapándose la boca con ambas manos, con los ojos casi cerrados de tanta risa.
young.joke.village_child.12 = {name}: ¡ES LO MÁS GRACIOSO QUE HE ESCUCHADO EN TODA MI VIDA! —QUE HA DURADO UNOS SEIS AÑOS.

young.joke.own_child.1 = {name} SE RÍE A CARCAJADAS: {parent}, ¡CUÉNTALO OTRA VEZ! ¡OTRA VEZ!
young.joke.own_child.2 = {name} se ríe tanto que termina sentándose en el césped.
young.joke.own_child.3 = {name}: Eres la persona más graciosa de toda la aldea. Ya les pregunté a todos.
young.joke.own_child.4 = {name} repite el chiste en voz baja para no olvidarlo.
young.joke.own_child.5 = {name} se ríe y luego se pone serio. Espera... ¿eso es verdad?
young.joke.own_child.6 = {name} RUEDA POR EL SUELO DE LA RISA: {parent}, ¡BASTA, BASTA, NO AGUANTO MÁS!
young.joke.own_child.7 = {name}: Recordaré ese chiste toda mi vida, {parent}.
young.joke.own_child.8 = {name}: {parent}, deberías contarles chistes a todos en la aldea. No saben lo que se pierden.
young.joke.own_child.9 = {name} se ríe tanto que se queda sin aire, pero aún intenta soltar otra carcajada.
young.joke.own_child.10 = {name} te abraza en medio de la risa, simplemente porque está feliz.
young.joke.own_child.11 = {name}: ¿Puedo contarle este chiste a mi maestra mañana? Nunca se ríe de nada.
young.joke.own_child.12 = {name} SE SECA UNA LÁGRIMA DE RISA: {parent}, ¡BASTA, YA ME DUELE LA BARRIGA!

young.joke.own_teen.1 = {name} contiene la risa: Ese chiste es antiquísimo. —la comisura de su boca lo delata.
young.joke.own_teen.2 = {name}: No es gracioso. —se ríe tres segundos después, sin poder evitarlo.
young.joke.own_teen.3 = {name} pone los ojos en blanco y sonríe a la vez, con cierto esfuerzo.
young.joke.own_teen.4 = {name}: Si cuentas ese chiste delante de mis amigos, me voy de la aldea.
young.joke.own_teen.5 = {name} se ríe de verdad y parece molestarse consigo mismo por hacerlo.
young.joke.own_teen.6 = {name} se muerde el labio para no reírse, pero fracasa estrepitosamente.
young.joke.own_teen.7 = {name}: Bueno, eso fue... —se detiene y respira—. Está bien, sí fue gracioso. Solo por esta vez.
young.joke.own_teen.8 = {name} gira el rostro mientras se ríe, fingiendo que fue un estornudo.
young.joke.own_teen.9 = {name}: Está bien, me quedo con ese para usarlo después y fingir que se me ocurrió a mí.
young.joke.own_teen.10 = {name} suelta una risa breve y se queda callado de inmediato, como si se hubiera delatado.
young.joke.own_teen.11 = {name}: No me reí. Lo viste mal. —sigue sonriendo.
young.joke.own_teen.12 = {name} niega con la cabeza y sonríe a pesar de sí mismo: Eres un caso. Me encanta.

young.joke.own_adult.1 = {name} se ríe: Ese es el mismo chiste de cuando tenía seis años. Sigue siendo malo.
young.joke.own_adult.2 = {name}: A veces cuento ese chiste y digo que se me ocurrió a mí.
young.joke.own_adult.3 = {name} niega con la cabeza y sonríe: De verdad, no cambias.
young.joke.own_adult.4 = {name} se ríe y luego guarda silencio un momento. Qué buen recuerdo.
young.joke.own_adult.5 = {name}: Guardaré ese chiste para mis propios hijos algún día.
young.joke.own_adult.6 = {name} se ríe de verdad: Todavía tienes talento para esto, ¿eh?
young.joke.own_adult.7 = {name}: Me alegra que alguien por aquí siga siendo gracioso. Lo necesitaba.
young.joke.own_adult.8 = {name}: ¿Sabes? Ese es exactamente el tipo de chiste que les cuento a mis amigos.
young.joke.own_adult.9 = {name} se ríe con ganas, desde el fondo del pecho: Hace tiempo que no me reía así.
young.joke.own_adult.10 = {name}: Debo admitir que siempre tuviste buen sentido del humor, incluso cuando fingía que no.
young.joke.own_adult.11 = {name} niega con la cabeza entre risas: Nunca dejarás de intentar hacerme reír, ¿verdad?
young.joke.own_adult.12 = {name}: Gracias por eso. De verdad. Hoy necesitaba reírme.

scold.child.1 = {name} mira al suelo y no dice nada. Le tiembla el labio.
scold.child.2 = {name} baja la mirada y raspa el suelo con el pie, en silencio.
scold.child.3 = {name} se encoge y guarda silencio, con los ojos llenos de lágrimas.
scold.child_excessive.1 = {name} ROMPE A LLORAR: ¡SIEMPRE ESTÁS ENOJADO CONMIGO! ¡NO HICE NADA!
scold.child_excessive.2 = {name} SOLLOZA Y SE CUBRE EL ROSTRO: ¿¡POR QUÉ SIEMPRE ME GRITAS A MÍ!?
scold.child_excessive.3 = {name} SE QUIEBRA AL HABLAR: ¡DE VERDAD INTENTO PORTARME BIEN, LO JURO! ¡POR FAVOR, DEJA DE PELEAR CONMIGO!
scold.teen.1 = {name} pone los ojos en blanco: Está bien. Lo que tú digas.
scold.teen.2 = {name} cruza los brazos: Está bien, ya entendí, puedes parar.
scold.teen.3 = {name} suspira exageradamente: Uf, está bien, ya entendí.
scold.teen_excessive.1 = {name} RESPONDE A GRITOS: ¡NUNCA ME ESCUCHAS! ¡YA NO SOY UN NIÑO! —Y SE MARCHA FURIOSO.
scold.teen_excessive.2 = {name} GOLPEA EL SUELO CON EL PIE: ¡SIEMPRE EXAGERAS! ¡YA NO SOY PEQUEÑO! —Y SE DA LA VUELTA.
scold.teen_excessive.3 = {name} ALZA LA VOZ: ¡YA TUVE SUFICIENTE! ¡DEJA DE TRATARME COMO A UN BEBÉ! —Y SALE ENFADADO.
scold.adult.1 = {name} suspira: Está bien, está bien. Después de todo, sigues siendo mi padre o mi madre.
scold.adult.2 = {name} niega con la cabeza: Está bien, está bien. Lo tendré en cuenta.
scold.adult.3 = {name} se encoge de hombros: De acuerdo, te escucho.
scold.adult_excessive.1 = {name} levanta una ceja: Soy un adulto. Quizá deberías bajar un poco el tono.
scold.adult_excessive.2 = {name} cruza los brazos: No soy un niño al que tengas que regañar todos los días.
scold.adult_excessive.3 = {name} respira hondo: Parece que has tenido un día difícil. Intenta relajarte un poco.
terms.mom_warm = mamita
terms.mom_plain = mamá
terms.dad_warm = papito
terms.dad_plain = papá

mean.aggressive.1 = {name} SACA SU ARMA: ¿¡QUIERES RESOLVER ESTO AHORA MISMO!?
mean.aggressive.2 = {name} APRIETA LOS PUÑOS: ¡REPÍTEMELO EN LA CARA SI TIENES VALOR!
mean.aggressive.3 = {name} TE EMPUJA: ¿¡QUIÉN TE CREES QUE ERES PARA HABLARME ASÍ!?
mean.aggressive.4 = {name} GRITA FURIOSAMENTE: ¡CÁLLATE ANTES DE QUE TE HAGA CALLAR!
mean.aggressive.5 = {name} escupe al suelo: Te arrepentirás de haber abierto la boca.
mean.needy.1 = {name} casi llora: ¿Por qué eres tan cruel conmigo? ¿Qué te hice?
mean.needy.2 = {name} se le llenan los ojos de lágrimas: Creí que éramos amigos...
mean.needy.3 = {name} olfatea con tristeza: Tus palabras duelen de verdad, ¿sabes?
mean.needy.4 = {name} baja la cabeza con tristeza: No tenías que ser tan grosero... Yo solo estaba aquí.
