# NPC CHAT - MAGIC GAME LOSE
magic.lose.hostile.1 = «Me rindo. Este juego no tiene sentido», dice {name}.
magic.lose.hostile.2 = {name} se encoge de hombros. «Fuera lo que fuera, ya no me importa».
magic.lose.hostile.3 = «Supongo que ganas. No es que me importara», murmura {name}.
magic.lose.stranger.1 = «La verdad, no estoy seguro. Me dejaste sin ideas», dice {name}.
magic.lose.stranger.2 = {name} admite la derrota. «No logro adivinarlo».
magic.lose.stranger.3 = «Bueno, esta vez me ganaste», dice {name}.
magic.lose.acquaintance.1 = «¡VAYA, GANASTE! NO PUDE ADIVINARLO», DICE {name} CON UNA SONRISA.
magic.lose.acquaintance.2 = {name} SE RÍE. «¡ESTÁ BIEN, ME ATRAPASTE! ¿QUÉ ERA?»
magic.lose.acquaintance.3 = «¡ME RINDO! DIME, ¿QUÉ ERA?», PREGUNTA {name} CON CURIOSIDAD.
magic.lose.friend.1 = «¡JA, POR FIN ME DEJASTE SIN RESPUESTA, AMIGO!», SE RÍE {name}.
magic.lose.friend.2 = {name} sonríe ampliamente. «De acuerdo, ganas esta ronda. ¿Revancha pronto?»
magic.lose.friend.3 = «NO LO ADIVINÉ, ¡PERO FUE DIVERTIDO! ¿QUÉ ERA?», PREGUNTA {name}.
magic.lose.close_friend.1 = «¡GANASTE! ME ENCANTA QUE TODAVÍA PUEDAS SORPRENDERME», DICE {name} ENTRE RISAS.
magic.lose.close_friend.2 = {name} te abraza. «No lo adiviné, pero me divertí muchísimo contigo».
magic.lose.close_friend.3 = «¡VOLVISTE A GANARME! NO ME IMPORTA PERDER CONTIGO», DICE {name} CON CARIÑO.

