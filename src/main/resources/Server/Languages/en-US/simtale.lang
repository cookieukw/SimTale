chat.busy_multiplayer = <%name%> Sorry, I'm talking to someone else right now.
chat.cancel = <%name%> Alright, see you later! Just call if you need anything.
chat.magic.start = <%name%> Yay! Let's play MagicGinn. Think of an animal and answer with Yes or No.
chat.magic.reject = <%name%> We are not close enough for me to play with you.
chat.busy_job = <%name%> I'm already busy with my %job% job!
chat.come = <%name%> I'm coming!
chat.greeting.1 = <%name%> Hey, did you call? Need something? (Say 'fish', 'mine', etc)
chat.greeting.2 = <%name%> What's up! How are you doing? (Say 'fish', 'mine', etc)
chat.greeting.3 = <%name%> Hi! Do you have a mission for me? (Say 'fish', 'mine', etc)
chat.greeting.4 = <%name%> I'm here. What do you want me to do? (Say 'fish', 'mine', etc)
chat.greeting.5 = <%name%> Hey! Ready to work. Tell me what you need. (Say 'fish', 'mine', etc)
chat.smalltalk.1 = <%name%> Haha, I didn't get what you said, but the day is beautiful today, isn't it?
chat.smalltalk.2 = <%name%> Hmm... do you want me to do something or are we just chatting?
chat.smalltalk.3 = <%name%> I didn't get it... If you want me to work, say the action directly, like 'mine' or 'farm'.
chat.smalltalk.4 = <%name%> What? Sorry, I was daydreaming. What was I supposed to do?
chat.smalltalk.5 = <%name%> Interesting... but I didn't understand. Do you have a task for me?
chat.magic.win = <%name%> I know! The animal you thought of is: %animal_name%!
chat.magic.lose = <%name%> I couldn't guess! You beat me!
chat.magic.question = <%name%> Question %num%: %question%
chat.prof.reject = <%name%> You're not my boss! I won't change professions just because you told me to. (Requires 20 friendship)
chat.prof.accept = <%name%> Very well, from today onwards I'll be a %prof_name%!
chat.prof.invalid = <%name%> I didn't understand what profession you want me to have. Try 'become a miner', 'become a farmer', etc.
chat.job.wrong_prof = <%name%> Sorry, I'm a %prof_name% and I don't know how to do %job_name% work!
chat.job.reject = <%name%> We barely know each other! I won't work for you for free. (Requires 10 friendship)
chat.job.accept = <%name%> Alright, getting ready to do %job_name% work!

tick.job.depart = <%name%> I'm leaving now! I'll be back as soon as I finish.
tick.job.complete = <%name%> I finished my %job_name% work and came back!
tick.chat.timeout = <%name%> Hmm, I think you're busy. Let's talk later!

cmd.spawn.usage = Correct usage: /simtale spawn [NPCType]
cmd.spawn.error = Error spawning NPC of type %type%.
cmd.spawn.success = Spawned NPC of type %type%!
cmd.reload.db = Reassembling NPCs from the database...
cmd.here.success = Called %count% NPCs to your position!
chat.magic.cancel = <%name%> Ah, what a shame! We can play later then.
chat.magic.invalid = <%name%> I didn't get that! Answer: Yes, No, Don't know, or Quit.
cmd.interact.none = No living NPCs nearby!
cmd.interact.success = Forced UI to open for %name%
