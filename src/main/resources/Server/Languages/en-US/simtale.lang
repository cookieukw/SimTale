chat.busy_multiplayer.1 = {name}: Sorry, I'm talking to someone else right now.
chat.busy_multiplayer.2 = {name}: Hold on a sec, I'm in the middle of a chat!
chat.busy_multiplayer.3 = {name}: My bad, I'm busy talking to someone else.
chat.cancel.1 = {name}: Alright, see you later! Just call if you need anything.
chat.cancel.2 = {name}: Okay, I'm off! Let me know if you need me.
chat.cancel.3 = {name}: Sure thing! See you around!
chat.magic.start.1 = {name}: Yay! Let's play MagicGinn. Think of an animal and answer with Yes or No.
chat.magic.start.2 = {name}: Cool! Think of an animal and let's play MagicGinn! Just say Yes or No.
chat.magic.start.3 = {name}: I love this game! Focus on an animal and I'll guess it. Answer Yes or No!
chat.magic.reject.1 = {name}: We are not close enough for me to play with you.
chat.magic.reject.2 = {name}: Hmm... I think we need to get to know each other better first.
chat.magic.reject.3 = {name}: Not really feeling like it right now. We barely talk!
chat.busy_job.1 = {name}: I'm already busy with my {job} job!
chat.busy_job.2 = {name}: I can't right now, I'm focused on my {job} duties!
chat.busy_job.3 = {name}: Sorry, I'm in the middle of working as a {job}!
chat.come.1 = {name}: I'm coming!
chat.come.2 = {name}: Be right there!
chat.come.3 = {name}: On my way, wait for me!
chat.greeting.1 = {name}: Hey, did you call? Need something? (Say 'fish', 'mine', etc)
chat.greeting.2 = {name}: What's up! How are you doing? (Say 'fish', 'mine', etc)
chat.greeting.3 = {name}: Hi! Do you have a mission for me? (Say 'fish', 'mine', etc)
chat.greeting.4 = {name}: I'm here. What do you want me to do? (Say 'fish', 'mine', etc)
chat.greeting.5 = {name}: Hey! Ready to work. Tell me what you need. (Say 'fish', 'mine', etc)
chat.smalltalk.1 = {name}: Hey! It's a great day to explore, isn't it?
chat.smalltalk.2 = {name}: Yo! Everything alright over there?
chat.smalltalk.3 = {name}: That's crazy! But hey, any news?
chat.smalltalk.4 = {name}: Haha, for sure. You always come up with these ideas.
chat.smalltalk.5 = {name}: Yeah, exactly! I was just thinking about what we should do tomorrow.
chat.smalltalk.6 = {name}: Uh-huh... You know, I'm kind of craving something to eat right now.
chat.smalltalk.7 = {name}: Oh, definitely! I was thinking the exact same thing!
chat.smalltalk.8 = {name}: Be careful with the monsters at night, I heard some weird noises yesterday...
chat.smalltalk.9 = {name}: Ah, nice. But hey, do you want to do something together?
chat.smalltalk.10 = {name}: Interesting... although I'm mostly focused on working and earning some coins.
chat.magic.win.1 = {name}: I know! The animal you thought of is: {animal_name}!
chat.magic.win.2 = {name}: Too easy! You thought of a {animal_name}!
chat.magic.win.3 = {name}: Ha! Guessed it! It's a {animal_name}!
chat.magic.lose.1 = {name}: I couldn't guess! You beat me!
chat.magic.lose.2 = {name}: Wow, that was hard. You win this time!
chat.magic.lose.3 = {name}: I give up! What was it? You're too good at this!
chat.magic.question.1 = {name}: Question {num}: {question}
chat.magic.question.2 = {name}: Here comes question {num}: {question}
chat.magic.question.3 = {name}: Tell me (Question {num}): {question}
chat.prof.reject.1 = {name}: You're not my boss! I won't change professions just because you told me to. (Requires 20 friendship)
chat.prof.reject.2 = {name}: Who gave you the right to boss me around? I'm not changing my job! (Requires 20 friendship)
chat.prof.reject.3 = {name}: I like what I do, why would I change it just for you? (Requires 20 friendship)
chat.prof.accept.1 = {name}: Very well, from today onwards I'll be a {prof_name}!
chat.prof.accept.2 = {name}: Alright! You can call me the newest {prof_name} in town!
chat.prof.accept.3 = {name}: I like the sound of that. I'll start working as a {prof_name} right now!
chat.prof.invalid.1 = {name}: I didn't understand what profession you want me to have. Try 'become a miner', 'become a farmer', etc.
chat.prof.invalid.2 = {name}: What profession is that? Try being clearer, like: 'become a miner'.
chat.prof.invalid.3 = {name}: Huh? I don't know that job. Say something like 'become a farmer'.
chat.job.wrong_prof.1 = {name}: Sorry, I'm a {prof_name} and I don't know how to do {job_name} work!
chat.job.wrong_prof.2 = {name}: I'm no good at {job_name}, my expertise is being a {prof_name}!
chat.job.wrong_prof.3 = {name}: Wait, I'm a {prof_name}, I have no clue how to work as a {job_name}.
chat.job.reject.1 = {name}: We barely know each other! I won't work for you for free. (Requires 10 friendship)
chat.job.reject.2 = {name}: Do you think I'm your servant? We're barely friends! (Requires 10 friendship)
chat.job.reject.3 = {name}: I'm not doing that, we hardly even talk. (Requires 10 friendship)
chat.job.accept.1 = {name}: Alright, getting ready to do {job_name} work!
chat.job.accept.2 = {name}: Cool, I'm heading out to start my {job_name} duties!
chat.job.accept.3 = {name}: Leave it to me, {job_name} work is about to begin.
tick.job.depart.1 = {name}: I'm leaving now! I'll be back as soon as I finish.
tick.job.depart.2 = {name}: I'm off! I'll be back later.
tick.job.depart.3 = {name}: Off to work! I'll finish up shortly.
tick.job.complete.1 = {name}: I finished my {job_name} work and came back!
tick.job.complete.2 = {name}: Phew, done with the {job_name} work. I'm back!
tick.job.complete.3 = {name}: Mission accomplished! The {job_name} job is complete.
tick.chat.timeout.1 = {name}: Hmm, I think you're busy. Let's talk later!
tick.chat.timeout.2 = {name}: You seem distracted... we can talk later!
tick.chat.timeout.3 = {name}: I see you're not in a chatting mood today. Bye!
cmd.spawn.usage = Correct usage: /simtale spawn [NPCType]
cmd.spawn.error = Error spawning NPC of type {type}.
cmd.spawn.success = Spawned NPC of type {type}!
cmd.reload.db = Reassembling NPCs from the database...
cmd.here.success = Called {count} NPCs to your position!
chat.magic.cancel.1 = {name}: Ah, what a shame! We can play later then.
chat.magic.cancel.2 = {name}: No problem, maybe next time!
chat.magic.cancel.3 = {name}: We'll leave the game for later, that's fine!
chat.magic.invalid.1 = {name}: I didn't get that! Answer: Yes, No, Don't know, or Quit.
chat.magic.invalid.2 = {name}: Invalid answer. It has to be Yes, No, Don't know, or Quit.
chat.magic.invalid.3 = {name}: Huh? Try again using Yes, No, Don't know, or Quit.
cmd.interact.none = No living NPCs nearby!
cmd.interact.success = Forced UI to open for {name}
