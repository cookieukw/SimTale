toddler.heal = {parent} cared for toddler {baby}'s health.

# MOVED GREETINGS & RANDOM
greeting.stranger.1 = {name}: Oh, hello. I don't think we've formally met.
greeting.stranger.2 = {name}: Greetings. Are you new around here?
greeting.stranger.3 = {name}: Hi. Can I help you with something?
greeting.stranger.4 = {name}: Um, hello. Nice weather today, I guess?
greeting.stranger.5 = {name} nods politely: Good day to you.
greeting.close_friend.1 = {name}'s face lights up: Hey! It's so good to see you!
greeting.close_friend.2 = {name}: There you are! I was hoping we'd run into each other today.
greeting.close_friend.3 = {name}: Hey bestie! What are we up to today?
greeting.close_friend.4 = {name}: Always a pleasure to see my favorite person around!
greeting.close_friend.5 = {name} gives a high-five: What's the plan for today?
greeting.romantic.1 = {name} smiles warmly: There's my love. How are you doing?
greeting.romantic.2 = {name}: I was just thinking about you. Come here!
greeting.romantic.3 = {name} blushes slightly: Seeing you always makes my day better.
greeting.romantic.4 = {name}: Hello, darling. Need anything from me today?
greeting.romantic.5 = {name}: My favorite person is here!
greeting.enemy.1 = {name} glares at you: What do you want now?
greeting.enemy.2 = {name} crosses their arms: Make it quick, I don't have time for you.
greeting.enemy.3 = {name} sighs heavily: You again? Unbelievable.
random.stranger = {name}: Did you know the weather patterns here are quite unpredictable?
random.known = {name}: Hey, remember that time we fought off those skeletons? Good times.

# JUICE & PROXIMITY
romantic.blush_feedback = {name} blushed deeply and blew you a kiss! 💕
mean.shove_feedback = {name} became furious and shoved you angrily!
proximity.stranger.1 = Greetings, traveler.
proximity.stranger.2 = Hi there! I don't know you, but welcome.
proximity.stranger.3 = Hey, watch your step around here.
proximity.friend.1 = Hey {player}! Good to see you around!
proximity.friend.2 = Hey, {player}! Glad you stopped by.
proximity.friend.3 = Look who it is! Hi, {player}!
proximity.partner.1 = Hello my love! I was missing you. 💕
proximity.partner.2 = Hey, you! I'm always happy to see you. 💕
proximity.partner.3 = There's my love! Come give me a hug. 💕
proximity.enemy.1 = Don't even think about coming near me...
proximity.enemy.2 = You again? Just keep walking.
proximity.enemy.3 = Get out of my sight.

# Child/teen voices for the proximity greeting (ChildDialogue, intent "proximity"). No {name}
# baked in -- RoutineAISystem.checkPlayerProximityGreeting already prepends "Name: " outside,
# same as the other proximity.* keys above. {parent} comes from ParentChildBond.parentTermKey
# (mommy/daddy, degrading to mom/dad and then the player's own name).
young.proximity.village_child.1 = Hi! You're really tall up close.
young.proximity.village_child.2 = *stares at you, curious* Hi...
young.proximity.village_child.3 = Hey, have you seen my ball around here?
young.proximity.village_child.4 = Hi! I'm not supposed to talk to strangers, but you seem nice.
young.proximity.village_child.5 = *points at you* A real grown-up!
young.proximity.village_child.6 = Hi! Did you bring anything good to eat?
young.proximity.village_child.7 = *hops in place* Hi! I grew a little, you know?
young.proximity.village_child.8 = Hey, hey, look at me!
young.proximity.village_child.9 = Hi! Do you know everyone in the village?
young.proximity.own_child.1 = Hi, {parent}! Hi hi hi!
young.proximity.own_child.2 = {parent}!! You're back!
young.proximity.own_child.3 = *runs up and hugs your leg* {parent}!
young.proximity.own_child.4 = {parent}, look, I was waiting for you!
young.proximity.own_child.5 = Hi {parent}! Come see something I found!
young.proximity.own_child.6 = {parent}! Stay with me a little bit?
young.proximity.own_child.7 = *tugs at your clothes* Hi, hi, hi, {parent}!
young.proximity.own_child.8 = {parent}, I missed you!
young.proximity.own_child.9 = *huge grin* Hi {parent}!! Guess what I did today!
young.proximity.own_teen.1 = Hey, {parent}.
young.proximity.own_teen.2 = *waves without much enthusiasm* Hey.
young.proximity.own_teen.3 = Oh, hi {parent}. All good.
young.proximity.own_teen.4 = {parent}... hi. — and goes back to staring at nothing.
young.proximity.own_teen.5 = *half-smiles* Hey. Good to see you, but don't tell anyone I said that.
young.proximity.own_teen.6 = *barely looks up* Hi.
young.proximity.own_teen.7 = Oh. It's you. Hi.
young.proximity.own_teen.8 = {parent}. — pause — ...hi.
young.proximity.own_teen.9 = *stops what they were doing* Oh. Hi, {parent}.
young.proximity.own_adult.1 = Hi, {parent}! Good to see you.
young.proximity.own_adult.2 = {parent}! Come here, it's been a while since we really talked.
young.proximity.own_adult.3 = *smiles* Hi {parent}. How are you?
young.proximity.own_adult.4 = Hey, {parent}! I was just thinking about you today.
young.proximity.own_adult.5 = Hi, {parent}. Always good to have you around.
young.proximity.own_adult.6 = *waves* Hi, {parent}. Good to see you around.
young.proximity.own_adult.7 = {parent}! Was hoping you'd show up.
young.proximity.own_adult.8 = Hi. How's your day been so far?
young.proximity.own_adult.9 = *smiles faintly* {parent}. Always a good moment to stop and talk.

# NPC-NPC CONTEXTUAL SOCIAL DIALOGUES
social.hostile.1.a = {name}: Get out of my face! I don't want to talk to you!
social.hostile.1.b = {name}: Don't push your luck! You'll regret picking a fight with me!
social.hostile.2.a = {name}: What are you looking at? Beat it!
social.hostile.2.b = {name}: Who do you think you are to boss me around?!

social.romantic.1.a = {name}: My love! It's so wonderful seeing you here.
social.romantic.1.b = {name}: My day is always brighter the moment I see your face.
social.romantic.2.a = {name}: I was just thinking about you...
social.romantic.2.b = {name}: Really? I wouldn't leave your side for the world.
social.romantic.3.a = {name}: You know, the other day I caught myself thinking about when we first met.
social.romantic.3.b = {name}: Aw, that's sweet... I think about that sometimes too.

social.hunger.1.a = {name}: My stomach is growling... I need to find something to eat soon.
social.hunger.1.b = {name}: Tell me about it! If I don't get some food soon, I might pass out.
social.hunger.2.a = {name}: Have you seen any snacks or stew nearby? I'm starving.
social.hunger.2.b = {name}: I think I smelled cooking earlier, go take a look over there!

social.fatigue.1.a = {name}: My eyelids feel so heavy... I'm exhausted.
social.fatigue.1.b = {name}: I can barely stand on my feet either, can't wait to get to bed.
social.fatigue.2.a = {name}: Worked way too hard today, my back is killing me.
social.fatigue.2.b = {name}: You really should rest a bit before you overwork yourself.

social.work.farm.1.a = {name}: The crops are coming along nicely, harvest should be plentiful.
social.work.farm.1.b = {name}: Wonderful news! The soil around here is remarkably rich.
social.work.farm.2.a = {name}: Need to water and tend to the fields before the sun gets too high.
social.work.farm.2.b = {name}: Best of luck out there! The village appreciates the fresh harvest.

social.work.wood.1.a = {name}: Spent the morning chopping logs. The timber here is solid!
social.work.wood.1.b = {name}: That's great! We'll need plenty of firewood and building timber.
social.work.wood.2.a = {name}: My axe is getting dull from felling all these dry logs.
social.work.wood.2.b = {name}: Careful not to hurt yourself, good timber takes steady work.

social.work.guard.1.a = {name}: Quiet patrol so far. No hostile beasts lurking near the borders.
social.work.guard.1.b = {name}: Good to keep your guard up anyway. You never know what's in the woods.
social.work.guard.2.a = {name}: Keeping this settlement safe is our highest duty.
social.work.guard.2.b = {name}: We all rest easier knowing you're standing watch.

social.work.fish.1.a = {name}: The fish are really biting down by the creek today!
social.work.fish.1.b = {name}: Fantastic! A fresh grilled fish dinner tonight would hit the spot.
social.work.fish.2.a = {name}: Water was calm this morning, perfect for casting lines.
social.work.fish.2.b = {name}: Fishing sounds like such peaceful and soothing work...

social.mood.happy.1.a = {name}: Woke up with wonderful energy today! Everything feels bright.
social.mood.happy.1.b = {name}: I can see that smile from a mile away! It's infectious.
social.mood.happy.2.a = {name}: Some days village life just feels truly peaceful.
social.mood.happy.2.b = {name}: It really does! Blessed to live in such a nice town.

social.mood.sad.1.a = {name}: Today hasn't been the easiest day... feeling a bit down.
social.mood.sad.1.b = {name}: I'm sorry to hear that. I'm always here if you need to talk, friend.
social.mood.sad.2.a = {name}: Sometimes things just feel heavy, you know?
social.mood.sad.2.b = {name}: I know the feeling. Hang in there, things will look up soon.

social.night.1.a = {name}: Night fell so fast... gets quite dangerous wandering in the dark.
social.night.1.b = {name}: Absolutely. Better stick to the torches and head indoors soon.
social.night.2.a = {name}: The shadows out here at night make me a bit uneasy.
social.night.2.b = {name}: Make sure your doors are bolted shut before you sleep.

social.weather.1.a = {name}: The weather today is delightful, neither too hot nor too cold.
social.weather.1.b = {name}: Agreed! Perfect day for a walk outside.
social.weather.2.a = {name}: There's such a gentle breeze blowing through the trees today.
social.weather.2.b = {name}: A very refreshing breeze indeed!

social.village.1.a = {name}: Our village has been looking livelier and prettier by the day.
social.village.1.b = {name}: True! It's wonderful seeing everyone bustling and living in peace.
social.village.2.a = {name}: Once daily chores are finished, I'm planning a long stroll around town.
social.village.2.b = {name}: If my chores are done in time, I'll join you on that walk!

social.child_play.1.a = {name}: Let's play tag! I'll count to ten!
social.child_play.1.b = {name}: This time I'm totally going to catch you fast!
social.child_play.2.a = {name}: Hey, I found a new bug today. Want to see?
social.child_play.2.b = {name}: Ooh, let me see! Does it bite?

# CHILD PLAY: tag and hide-and-seek between children (lines said during the game itself, not in
# response to the player -- see playing.* referenced by ChildPlayHelper/RoutineAISystem)
# No {name} embedded -- the caller already prefixes "NpcName: " externally, same as proximity.*.
playing.tag_start.1 = Tag! You can't catch me!
playing.tag_start.2 = Let's play tag! I'll count to three!
playing.tag_start.3 = Run, run! Tag!
playing.tag_chasing.1 = I'm gonna get you, I'm gonna get you!
playing.tag_chasing.2 = You're not getting away this time!
playing.tag_chasing.3 = Where are you, where... ah, there!
playing.tag_fleeing.1 = You can't catch me, you can't catch me!
playing.tag_fleeing.2 = Not yet! Run, run!
playing.tag_fleeing.3 = So close, but you missed!
playing.tag_tagged.1 = Tag, you're it!
playing.tag_tagged.2 = Passing the hot potato to you now!
playing.tag_end.1 = Phew, I'm tired! That was so much fun!
playing.tag_end.2 = Again later, okay? I loved playing!
playing.hideseek_start.1 = Let's play hide-and-seek! I'll count to ten, go hide!
playing.hideseek_start.2 = Hide-and-seek! Close your eyes, I'm going to find a spot!
playing.hideseek_hiding.1 = Shh... will she find me here?
playing.hideseek_hiding.2 = What a good hiding spot I found, huh?
playing.hideseek_hiding.3 = Stay quiet... quiet...
playing.hideseek_seeking.1 = One, two, three... where are you?
playing.hideseek_seeking.2 = Here I come to find you! Where did she go...
playing.hideseek_seeking.3 = Hmm, behind the tree? No... let me check over there!
playing.hideseek_found.1 = Found you!
playing.hideseek_found.2 = Found you! Now it's your turn to seek!
playing.hideseek_end.1 = That was so much fun hiding! Let's do it again sometime!
playing.hideseek_end.2 = You're really good at hiding! I almost couldn't find you!

npc_marriage.announce = {name} beams, holding hands with {partner}: We got married! It all happened so fast, but it feels right.

# WORLD EVENT COMMENTARY (docs/ROADMAP.md: "comentários sobre eventos do mundo")
# No {name} embedded -- the caller already prefixes "NpcName: " externally, same as proximity.*.
world_event.guard_victory.1 = One less danger around here!
world_event.guard_victory.2 = That was for the village!
world_event.guard_victory.3 = Nobody threatens these lands while I'm on watch.
world_event.guard_victory_witness.1 = Whoa, did you see that?! The guard was amazing!
world_event.guard_victory_witness.2 = That was scary... but the guard saved everyone!
world_event.guard_victory_witness.3 = That was just like a real hero!
world_event.kweebec_sighted.1 = Look, a Kweebec! Haven't seen one near the village in a while.
world_event.kweebec_sighted.2 = Psst, there's a Kweebec peeking over there. Curious little thing.
world_event.kweebec_sighted.3 = A Kweebec around here again... they love wandering this area.
