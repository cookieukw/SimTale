// Registered baths browser.
//
// SimBathDebugPage addresses the rows by composing ids -- "#Row0 #Coords", "#Row2 #BtnTp" and so
// on -- so the @BathRow template, the five #Row0..#Row4 instances and the inner #Coords, #Status,
// #BtnTp and #BtnForget ids all have to keep their names.

$T = "../SimTaleTheme.ui";

@RowH   = 76;
@RowBtnW = 118;
@RowBtnH = 38;

// One bath entry. Same shape as a bed row: coordinates plus a single status line, no third line
// of contents like the chest row has.
@BathRow = Group {
  Anchor: (Height: @RowH, Bottom: 8);
  LayoutMode: Left;
  Background: $T.@InsetSurface;
  Padding: (Horizontal: 14, Vertical: 9);

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #Coords {
      Text: "Posição: X: 0, Y: 0, Z: 0";
      Anchor: (Height: 28, Bottom: 2);
      Style: (...$T.@BodyStrong, FontSize: 15);
    }
    Label #Status {
      Text: "Status: LIVRE";
      Anchor: (Height: 24);
      Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@AccentLike);
    }
  }

  Button #BtnTp {
    Anchor: (Width: @RowBtnW, Height: @RowBtnH, Top: 10, Right: 8);
    Style: $T.@BtnNeutral;
    Label { Text: %ui.debugbaths.btnTp; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
  }

  // Drops the tile from the registry without touching the block, same as the chest row's Forget.
  Button #BtnForget {
    Anchor: (Width: @RowBtnW, Height: @RowBtnH, Top: 10);
    Style: $T.@BtnDestructive;
    Label { Text: %ui.debugbaths.btnForget; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
  }
};

Group {
  LayoutMode: MiddleCenter;
  Background: #060911(0.85);

  SceneBlur {}

  Group #MainPanel {
    Anchor: (Width: 640, Height: 700);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Horizontal: $T.@GutterOuter, Vertical: 20);

    Label #Title {
      Text: %ui.debugbaths.title;
      Anchor: (Height: 34, Bottom: 4);
      Style: (...$T.@TitleStyle, FontSize: 24, TextColor: $T.@TextBlue);
    }

    $T.@Separator { @Anchor = (Bottom: 12); }

    Group #EmptyContainer {
      FlexWeight: 1;
      LayoutMode: MiddleCenter;
      Visible: false;

      Group {
        LayoutMode: MiddleCenter;
        Anchor: (Width: 440);

        Group #EmptyIcon {
          Anchor: (Width: 64, Height: 64, Bottom: 16);
          Background: $T.@IconEmptyBath;
        }

        Label #EmptyTitle {
          Text: %ui.debugbaths.emptyTitle;
          Anchor: (Height: 28, Bottom: 6);
          Style: (...$T.@TitleStyle, FontSize: 20, TextColor: $T.@TextBlue, HorizontalAlignment: Center);
        }

        Label #EmptySubtitle {
          Text: %ui.debugbaths.emptySubtitle;
          Anchor: (Height: 24);
          Style: (...$T.@CaptionStyle, FontSize: 14, TextColor: $T.@TextMuted, HorizontalAlignment: Center, Wrap: true);
        }
      }
    }

    Group #ListContainer {
      FlexWeight: 1;
      LayoutMode: Top;

      @BathRow #Row0 {}
      @BathRow #Row1 {}
      @BathRow #Row2 {}
      @BathRow #Row3 {}
      @BathRow #Row4 {}
    }

    Group {
      Anchor: (Height: 42, Top: 12, Bottom: 8);
      LayoutMode: Left;

      Button #BtnPrevPage {
        Anchor: (Width: 148, Height: 42, Right: 10);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.debugbaths.btnPrev; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
      Label #PageIndex {
        Text: "Página 1 / 1";
        Anchor: (Width: 284, Height: 42, Right: 10);
        Style: (...$T.@BodyStrong, HorizontalAlignment: Center);
      }
      Button #BtnNextPage {
        Anchor: (Width: 148, Height: 42);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.debugbaths.btnNext; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
    }

    Button #BtnBack {
      Anchor: (Height: 42);
      Style: $T.@BtnNeutral;
      Label { Text: %ui.debugbaths.btnBack; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
    }
  }
}
