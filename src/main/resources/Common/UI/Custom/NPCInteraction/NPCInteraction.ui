// NPC interaction panel.
//
// Every #id here is part of the contract with NPCInteractionPage.java: the click bindings
// target the Button ids (#ChatButton) and the text is written into the child Label ids
// (#ChatButtonText.TextSpans). Removing or renaming one throws KeyNotFoundException and the
// screen fails to load, so the structure is preserved exactly — only the presentation changed.

$T = "../SimTaleTheme.ui";

Group {
  LayoutMode: Right;
  Background: #00000000;

  Group #MainPanel {
    Anchor: (Right: 64, Width: 560, Height: 940);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Top: 24, Bottom: 22, Horizontal: $T.@GutterOuter);

    // ---------------------------------------------------------------- header
    Label #NpcName {
      Text: "NPC";
      Anchor: (Height: 44, Bottom: 2);
      Style: $T.@TitleStyle;
    }
    Label #NpcProfession {
      Text: "Profissão: Desempregado";
      Anchor: (Height: 24);
      Style: $T.@SubtitleStyle;
    }
    Label #NpcMood {
      Text: "Humor: Feliz";
      Anchor: (Height: 22, Bottom: 4);
      Style: $T.@CaptionStyle;
    }

    $T.@Separator { @Anchor = (Bottom: $T.@SectionGap); }

    // ---------------------------------------------------------------- info well
    Group #InfoPanel {
      // Grew with the needs row added below; the rows are fixed-height so the panel has to follow.
      Anchor: (Height: 332, Bottom: $T.@SectionGap);
      LayoutMode: Top;
      Background: $T.@InsetSurface;
      Padding: (Top: 12, Bottom: 12, Horizontal: $T.@GutterInner);

      Label #InfoHeader {
        Text: "INFORMAÇÕES";
        Anchor: (Height: 22, Bottom: 8);
        Style: $T.@SectionHeaderStyle;
      }
      // Needs sit above the personality lines because they change minute to minute, while traits
      // and likes never do. The colour is set from Java so a starving NPC reads at a glance.
      Label #NpcNeeds {
        Text: "Fome: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStrong;
      }
      Label #NpcTraits {
        Text: "Traços: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStyle;
      }
      Label #NpcLikes {
        Text: "Gosta de: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: (...$T.@BodyStyle, TextColor: $T.@AccentLike);
      }
      Label #NpcHates {
        Text: "Odeia: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: (...$T.@BodyStyle, TextColor: $T.@AccentHate);
      }
      Label #NpcHobby {
        Text: "Hobby: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStyle;
      }
      Label #NpcSeason {
        Text: "Estação Fav.: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStyle;
      }
      Label #NpcFamilyParents {
        Text: "Pais: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStyle;
      }
      Label #NpcFamilyChildren {
        Text: "Filhos: —";
        Anchor: (Height: 26, Bottom: 10);
        Style: $T.@BodyStyle;
      }

      // The relationship line is the one number players actually track, so it sits in its own
      // well at the bottom of the panel instead of blending into the list above it.
      Group {
        Anchor: (Height: 34);
        Background: $T.@WellSurface;
        Padding: (Horizontal: 10);
        LayoutMode: Middle;

        Label #NpcRelationship {
          Text: "Relacionamento: Desconhecido";
          Anchor: (Height: 24);
          Style: (...$T.@BodyStrong, TextColor: $T.@TextBlue);
        }
      }
    }

    // ---------------------------------------------------------------- actions
    Group #ButtonGrid {
      LayoutMode: Top;

      Group #ButtonRow1 {
        Anchor: (Height: $T.@ButtonH, Bottom: $T.@ButtonGap);
        LayoutMode: CenterMiddle;

        Button #ChatButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnNeutral;
          Label #ChatButtonText {
            Text: "Bater Papo";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #JokeButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnNeutral;
          Label #JokeButtonText {
            Text: "Contar Piada";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }

      Group #ButtonRow2 {
        Anchor: (Height: $T.@ButtonH, Bottom: $T.@ButtonGap);
        LayoutMode: CenterMiddle;

        Button #FlirtButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnSecondary;
          Label #FlirtButtonText {
            Text: "Paquerar";
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentRomance);
          }
        }
        Button #GiftButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnSecondary;
          Label #GiftButtonText {
            Text: "Presentear";
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentLike);
          }
        }
      }

      Group #ButtonRow3 {
        Anchor: (Height: $T.@ButtonH, Bottom: $T.@ButtonGap);
        LayoutMode: CenterMiddle;

        Button #InsultButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnDestructive;
          Label #InsultButtonText {
            Text: "Insultar";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #AssignProfessionButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnTertiary;
          Label #AssignProfessionButtonText {
            Text: "Dar Emprego";
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentWork);
          }
        }
      }

      // Both of these start hidden and are revealed from Java via #X.Visible.
      Group #ButtonRow4 {
        Anchor: (Height: $T.@ButtonH);
        LayoutMode: CenterMiddle;

        Button #PregnancyButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnSecondary;
          Visible: false;
          Label #PregnancyButtonText {
            Text: %ui.button.pregnancy;
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentRomance);
          }
        }
        Button #InventoryButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnTertiary;
          Visible: false;
          Label #InventoryButtonText {
            Text: "Inventário";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }
    }
  }
}
