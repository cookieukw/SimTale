// NPC interaction panel.
//
// Every #id here is part of the contract with NPCInteractionPage.java: the click bindings
// target the Button ids (#ChatButton) and the text is written into the child Label ids
// (#ChatButtonText.TextSpans). Removing or renaming one throws KeyNotFoundException and the
// screen fails to load, so the structure is preserved exactly — only the presentation changed.

$T = "../SimTaleTheme.ui";

// One showcase slot: the item on top, a short caption under it.
//
// The element is ItemIcon because that is the one item renderer proven to work from server code —
// ItemRepairElement writes "#Icon.ItemId" the exact same way. No ItemPreviewComponent appears in
// any of the 135 shipped .ui files, so it is not used here; if it turns out to exist, swapping is
// a one-line change inside this template and nothing else moves.
@ShowcaseSlot = Group {
  Anchor: (Width: 100);
  LayoutMode: Top;
  Padding: (Horizontal: 4);

  Group {
    Anchor: (Height: 40, Bottom: 3);
    LayoutMode: MiddleCenter;

    ItemIcon #Icon {
      Anchor: (Width: 36, Height: 36);
    }
  }

  Label #Caption {
    Text: "—";
    Anchor: (Height: 18);
    Style: (...$T.@BodyStyle, FontSize: 11, HorizontalAlignment: Center);
  }
};


// Bare icon for the taste rows: no caption, since the row label already says what it means.
@TasteIcon = Group {
  Anchor: (Width: 34, Height: 34, Right: 4);
  LayoutMode: MiddleCenter;

  ItemIcon #Icon {
    Anchor: (Width: 30, Height: 30);
  }
};

Group {
  LayoutMode: Right;
  Background: #00000000;

  Group #MainPanel {
    Anchor: (Right: 64, Width: 560, Height: 996);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Top: 24, Bottom: 22, Horizontal: $T.@GutterOuter);

    // ---------------------------------------------------------------- header
    Label #NpcName {
      Text: "NPC";
      Anchor: (Height: 44, Bottom: 2);
      Style: $T.@TitleStyle;
    }
    Label #NpcProfession {
      Text: "Profissão: Desempregado";
      Anchor: (Height: 24);
      Style: $T.@SubtitleStyle;
    }
    Label #NpcMood {
      Text: "Humor: Feliz";
      Anchor: (Height: 22, Bottom: 4);
      Style: $T.@CaptionStyle;
    }

    $T.@Separator { @Anchor = (Bottom: $T.@SectionGap); }

    // ---------------------------------------------------------------- info well
    Group #InfoPanel {
      // Height is the sum of the rows, not a guess — getting it wrong does not clip, it lets the
      // relationship well spill over the button grid below.
      //   padding 24 + header 22+8 + (hunger 26 + energy 26 + traits 26 + showcase 64 + likes 38
      //   + hates 38 + season 26 + parents 26) each with @RowGap 6 + children 26+10 + well 34 = 442
      Anchor: (Height: 442, Bottom: $T.@SectionGap);
      LayoutMode: Top;
      Background: $T.@InsetSurface;
      Padding: (Top: 12, Bottom: 12, Horizontal: $T.@GutterInner);

      Label #InfoHeader {
        Text: "INFORMAÇÕES";
        Anchor: (Height: 22, Bottom: 8);
        Style: $T.@SectionHeaderStyle;
      }
      // Needs sit above the personality lines because they change minute to minute, while traits
      // and likes never do. The colour is set from Java so a starving NPC reads at a glance.
      Label #NpcHunger {
        Text: "Fome: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStrong;
      }
      Label #NpcEnergy {
        Text: "Energia: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStrong;
      }
      Label #NpcTraits {
        Text: "Traços: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStyle;
      }
      // Four lines of "Gosta de: X / Odeia: Y / Hobby: Z / Profissão: W" became four pictures.
      // The captions stay, otherwise the row reads as a random inventory instead of a profile.
      Group #Showcase {
        Anchor: (Height: 64, Bottom: $T.@RowGap);
        LayoutMode: Left;

        @ShowcaseSlot #SlotProfession {}
        @ShowcaseSlot #SlotHobby {}
      }

      // Tastes get a row each, with room for the whole list. Showing only the first one made an
      // NPC look like it did not hate something it actually hated — an NPC rolls two to three
      // hated foods plus two to three hated items, so one icon was hiding up to five.
      Group #LikesRow {
        Anchor: (Height: 38, Bottom: $T.@RowGap);
        LayoutMode: Left;

        Label #LikesCaption {
          Text: "Gosta:";
          Anchor: (Width: 78, Height: 30, Top: 4);
          Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@AccentLike);
        }
        @TasteIcon #Like0 {}
        @TasteIcon #Like1 {}
        @TasteIcon #Like2 {}
        @TasteIcon #Like3 {}
        @TasteIcon #Like4 {}
        @TasteIcon #Like5 {}
      }

      Group #HatesRow {
        Anchor: (Height: 38, Bottom: $T.@RowGap);
        LayoutMode: Left;

        Label #HatesCaption {
          Text: "Odeia:";
          Anchor: (Width: 78, Height: 30, Top: 4);
          Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@AccentHate);
        }
        @TasteIcon #Hate0 {}
        @TasteIcon #Hate1 {}
        @TasteIcon #Hate2 {}
        @TasteIcon #Hate3 {}
        @TasteIcon #Hate4 {}
        @TasteIcon #Hate5 {}
      }
      Label #NpcSeason {
        Text: "Estação Fav.: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStyle;
      }
      Label #NpcFamilyParents {
        Text: "Pais: —";
        Anchor: (Height: 26, Bottom: $T.@RowGap);
        Style: $T.@BodyStyle;
      }
      Label #NpcFamilyChildren {
        Text: "Filhos: —";
        Anchor: (Height: 26, Bottom: 10);
        Style: $T.@BodyStyle;
      }

      // The relationship line is the one number players actually track, so it sits in its own
      // well at the bottom of the panel instead of blending into the list above it.
      Group {
        Anchor: (Height: 34);
        Background: $T.@WellSurface;
        Padding: (Horizontal: 10);
        LayoutMode: Middle;

        Label #NpcRelationship {
          Text: "Relacionamento: Desconhecido";
          Anchor: (Height: 24);
          Style: (...$T.@BodyStrong, TextColor: $T.@TextBlue);
        }
      }
    }

    // ---------------------------------------------------------------- actions
    Group #ButtonGrid {
      LayoutMode: Top;

      Group #ButtonRow1 {
        Anchor: (Height: $T.@ButtonH, Bottom: $T.@ButtonGap);
        LayoutMode: CenterMiddle;

        Button #ChatButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnNeutral;
          Label #ChatButtonText {
            Text: "Bater Papo";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #JokeButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnNeutral;
          Label #JokeButtonText {
            Text: "Contar Piada";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }

      Group #ButtonRow2 {
        Anchor: (Height: $T.@ButtonH, Bottom: $T.@ButtonGap);
        LayoutMode: CenterMiddle;

        Button #FlirtButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnSecondary;
          Label #FlirtButtonText {
            Text: "Paquerar";
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentRomance);
          }
        }
        Button #GiftButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnSecondary;
          Label #GiftButtonText {
            Text: "Presentear";
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentLike);
          }
        }
      }

      Group #ButtonRow3 {
        Anchor: (Height: $T.@ButtonH, Bottom: $T.@ButtonGap);
        LayoutMode: CenterMiddle;

        Button #InsultButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnDestructive;
          Label #InsultButtonText {
            Text: "Insultar";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #AssignProfessionButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnTertiary;
          Label #AssignProfessionButtonText {
            Text: "Dar Emprego";
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentWork);
          }
        }
      }

      // Both of these start hidden and are revealed from Java via #X.Visible.
      Group #ButtonRow4 {
        Anchor: (Height: $T.@ButtonH, Bottom: $T.@ButtonGap);
        LayoutMode: CenterMiddle;

        Button #PregnancyButton {
          Anchor: (Width: 250, Height: $T.@ButtonH, Right: $T.@ButtonGap);
          Style: $T.@BtnSecondary;
          Visible: false;
          Label #PregnancyButtonText {
            Text: %ui.button.pregnancy;
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentRomance);
          }
        }
        Button #InventoryButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnTertiary;
          Visible: false;
          Label #InventoryButtonText {
            Text: %ui.button.inventory;
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        // Only ever shown for a small child of the player's — see ChildCarryHelper. Shares the row
        // with the two above because all three are conditional, and no NPC ever qualifies for more
        // than two of them at once.
        Button #CarryButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnSecondary;
          Visible: false;
          Label #CarryButtonText {
            Text: %ui.button.carry;
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }

      // A deeper gesture than Flirt above -- hidden until the relationship is already a real
      // couple (PARTNER/ENGAGED/MARRIED). Its own row since it can be visible alongside any of
      // ButtonRow4's three conditional buttons at once (e.g. a married couple gets Kiss AND
      // Inventory together), unlike those three which never all show up simultaneously.
      Group #ButtonRow5 {
        Anchor: (Height: $T.@ButtonH);
        LayoutMode: CenterMiddle;

        Button #KissButton {
          Anchor: (Width: 250, Height: $T.@ButtonH);
          Style: $T.@BtnSecondary;
          Visible: false;
          Label #KissButtonText {
            Text: %ui.button.kiss;
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, TextColor: $T.@AccentRomance);
          }
        }
      }
    }
  }
}
