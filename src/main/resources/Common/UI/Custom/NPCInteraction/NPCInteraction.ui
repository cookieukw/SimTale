// NPC interaction panel.
//
// Every #id here is part of the contract with NPCInteractionPage.java: the click bindings
// target the Button ids (#ChatButton) and the text is written into the child Label ids
// (#ChatButtonText.TextSpans). Removing or renaming one throws KeyNotFoundException and the
// screen fails to load, so the structure is preserved exactly — only the presentation changed.

$T = "../SimTaleTheme.ui";

// One showcase slot: the item on top, a short caption under it.
@ShowcaseSlot = Group {
  Anchor: (Width: 96, Height: 56);
  LayoutMode: Top;

  Group {
    Anchor: (Height: 38, Bottom: 2);
    LayoutMode: MiddleCenter;

    ItemIcon #Icon {
      Anchor: (Width: 34, Height: 34);
    }
  }

  Label #Caption {
    Text: "—";
    Anchor: (Height: 16);
    Style: (...$T.@BodyStyle, FontSize: 11, HorizontalAlignment: Center, ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 9);
  }
};

// Bare icon for the taste rows: no caption, since the row label already says what it means.
@TasteIcon = Group {
  Anchor: (Width: 38, Height: 38, Right: 4, Top: 1);
  LayoutMode: MiddleCenter;

  ItemIcon #Icon {
    Anchor: (Width: 36, Height: 36);
  }
};

Group {
  LayoutMode: Right;
  Background: #00000000;

  Group #MainPanel {
    Anchor: (Right: 48, Width: 520, Height: 820);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Top: 18, Bottom: 16, Horizontal: 22);

    // ---------------------------------------------------------------- header
    Label #NpcName {
      Text: "NPC";
      Anchor: (Height: 32, Bottom: 4);
      Style: (...$T.@TitleStyle, FontSize: 24, HorizontalAlignment: Center);
    }

    Group #HeaderBadges {
      Anchor: (Height: 26, Bottom: 10);
      LayoutMode: CenterMiddle;

      Group #ProfessionBadge {
        Anchor: (Width: 213, Height: 26, Right: 10);
        Background: $T.@CardSurface;
        Padding: (Horizontal: 8, Vertical: 3);
        LayoutMode: MiddleCenter;

        Label #NpcProfession {
          Text: "Profissão: Desempregado";
          Anchor: (Height: 20);
          Style: (...$T.@SubtitleStyle, FontSize: 12, TextColor: $T.@TextGold, HorizontalAlignment: Center);
        }
      }

      Group #MoodBadge {
        Anchor: (Width: 213, Height: 26);
        Background: $T.@CardSurface;
        Padding: (Horizontal: 8, Vertical: 3);
        LayoutMode: MiddleCenter;

        Label #NpcMood {
          Text: "Humor: Feliz";
          Anchor: (Height: 20);
          Style: (...$T.@CaptionStyle, FontSize: 12, TextColor: $T.@TextPrimary, HorizontalAlignment: Center);
        }
      }
    }

    $T.@Separator { @Anchor = (Bottom: 8); }

    // ---------------------------------------------------------------- vitals
    Group #VitalsContainer {
      Anchor: (Height: 74, Bottom: 8);
      LayoutMode: Top;

      Group #HungerSection {
        Anchor: (Height: 33, Bottom: 8);
        LayoutMode: Top;

        Group {
          Anchor: (Height: 18, Bottom: 2);
          LayoutMode: Left;

          Label #NpcHunger {
            Text: "Fome: —";
            Anchor: (Full: 0);
            Style: (...$T.@BodyStrong, FontSize: 12);
          }
        }

        Group #HungerBarTrack {
          Anchor: (Height: 10);
          Background: $T.@BarTrack;
          Padding: (Horizontal: 3, Vertical: 1);

          Group #HungerBarFill {
            Anchor: (Width: 100, Height: 8);
            Background: $T.@BarFillAmber;
          }
        }
      }

      Group #EnergySection {
        Anchor: (Height: 33);
        LayoutMode: Top;

        Group {
          Anchor: (Height: 18, Bottom: 2);
          LayoutMode: Left;

          Label #NpcEnergy {
            Text: "Energia: —";
            Anchor: (Full: 0);
            Style: (...$T.@BodyStrong, FontSize: 12);
          }
        }

        Group #EnergyBarTrack {
          Anchor: (Height: 10);
          Background: $T.@BarTrack;
          Padding: (Horizontal: 3, Vertical: 1);

          Group #EnergyBarFill {
            Anchor: (Width: 100, Height: 8);
            Background: $T.@BarFillGreen;
          }
        }
      }
    }

    // ---------------------------------------------------------------- info well
    Group #InfoPanel {
      Anchor: (Height: 238, Bottom: 8);
      LayoutMode: Top;
      Background: $T.@InsetSurface;
      Padding: (Top: 9, Bottom: 9, Horizontal: 14);

      Label #InfoHeader {
        Text: "INFORMAÇÕES";
        Anchor: (Height: 16, Bottom: 4);
        Style: (...$T.@SectionHeaderStyle, FontSize: 11);
      }

      // Two-column identity details
      Group #InfoGrid {
        Anchor: (Height: 50, Bottom: 7);
        LayoutMode: Left;

        Group #InfoColLeft {
          Anchor: (Width: 218, Right: 18);
          LayoutMode: Top;

          Label #NpcTraits {
            Text: "Traços: —";
            Anchor: (Height: 23, Bottom: 3);
            Style: (...$T.@BodyStyle, FontSize: 13);
          }

          Label #NpcSeason {
            Text: "Estação Fav.: —";
            Anchor: (Height: 23);
            Style: (...$T.@BodyStyle, FontSize: 13);
          }
        }

        Group #InfoColRight {
          Anchor: (Width: 218);
          LayoutMode: Top;

          Label #NpcFamilyParents {
            Text: "Pais: —";
            Anchor: (Height: 23, Bottom: 3);
            Style: (...$T.@BodyStyle, FontSize: 13);
          }

          Label #NpcFamilyChildren {
            Text: "Filhos: —";
            Anchor: (Height: 23);
            Style: (...$T.@BodyStyle, FontSize: 13);
          }
        }
      }

      Label #PreferenceHeader {
        Text: "PREFERÊNCIAS";
        Anchor: (Height: 16, Bottom: 3);
        Style: (...$T.@SectionHeaderStyle, FontSize: 11);
      }

      // Showcase items (Profession & Hobby)
      Group #Showcase {
        Anchor: (Height: 52, Bottom: 5);
        LayoutMode: CenterMiddle;

        @ShowcaseSlot #SlotProfession {
          Anchor: (Width: 108, Height: 52, Right: 18);
        }
        @ShowcaseSlot #SlotHobby {
          Anchor: (Width: 108, Height: 52);
        }
      }

      // Taste rows (Likes & Hates)
      Group #LikesRow {
        Anchor: (Height: 36, Bottom: 3);
        LayoutMode: Left;

        Label #LikesCaption {
          Text: "Gosta:";
          Anchor: (Width: 70, Height: 32, Top: 2);
          Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@AccentLike, RenderBold: true);
        }
        @TasteIcon #Like0 {}
        @TasteIcon #Like1 {}
        @TasteIcon #Like2 {}
        @TasteIcon #Like3 {}
        @TasteIcon #Like4 {}
        @TasteIcon #Like5 {}
        Label #LikesLocked {
          Text: "";
          Anchor: (Width: 34, Height: 36, Top: 2, Left: 4);
          Style: (...$T.@CaptionStyle, FontSize: 12, TextColor: $T.@TextMuted);
        }
      }

      Group #HatesRow {
        Anchor: (Height: 36);
        LayoutMode: Left;

        Label #HatesCaption {
          Text: "Odeia:";
          Anchor: (Width: 70, Height: 32, Top: 2);
          Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@AccentHate, RenderBold: true);
        }
        @TasteIcon #Hate0 {}
        @TasteIcon #Hate1 {}
        @TasteIcon #Hate2 {}
        @TasteIcon #Hate3 {}
        @TasteIcon #Hate4 {}
        @TasteIcon #Hate5 {}
        Label #HatesLocked {
          Text: "";
          Anchor: (Width: 34, Height: 36, Top: 2, Left: 4);
          Style: (...$T.@CaptionStyle, FontSize: 12, TextColor: $T.@TextMuted);
        }
      }
    }

    // ---------------------------------------------------------------- relationship status
    Group #RelationshipCard {
      Anchor: (Height: 72, Bottom: 8);
      Background: $T.@WellSurface;
      Padding: (Horizontal: 14, Vertical: 7);
      LayoutMode: Top;

      Label #NpcRelationship {
        Text: "Relacionamento: Desconhecido";
        Anchor: (Height: 27, Bottom: 6);
        Style: (...$T.@BodyStrong, FontSize: 15, TextColor: $T.@TextGold);
      }

      Group #RelationshipBarTrack {
        Anchor: (Height: 12);
        Background: $T.@BarTrack;
        Padding: (Horizontal: 3, Vertical: 2);

        Group #RelationshipBarFill {
          Anchor: (Width: 80, Height: 8);
          Background: $T.@BarFillPink;
        }
      }
    }

    $T.@Separator { @Anchor = (Bottom: 8); }

    // ---------------------------------------------------------------- actions
    Group #ButtonGrid {
      LayoutMode: Top;

      Group #ButtonRow1 {
        Anchor: (Height: 38, Bottom: 6);
        LayoutMode: CenterMiddle;

        Button #ChatButton {
          Anchor: (Width: 213, Height: 38, Right: 10);
          Style: $T.@BtnChat;
          Label #ChatButtonText {
            Text: "Bater Papo";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #JokeButton {
          Anchor: (Width: 213, Height: 38);
          Style: $T.@BtnJoke;
          Label #JokeButtonText {
            Text: "Contar Piada";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }

      Group #ButtonRow2 {
        Anchor: (Height: 38, Bottom: 6);
        LayoutMode: CenterMiddle;

        Button #GiftButton {
          Anchor: (Width: 213, Height: 38, Right: 10);
          Style: $T.@BtnGift;
          Label #GiftButtonText {
            Text: "Presentear";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #FlirtButton {
          Anchor: (Width: 213, Height: 38);
          Style: $T.@BtnFlirt;
          Label #FlirtButtonText {
            Text: "Paquerar";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #CarryButton {
          Anchor: (Width: 213, Height: 38);
          Style: $T.@BtnCarry;
          Visible: false;
          Label #CarryButtonText {
            Text: %ui.button.carry;
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }

      Group #ButtonRow3 {
        Anchor: (Height: 38, Bottom: 6);
        LayoutMode: CenterMiddle;

        Button #AssignProfessionButton {
          Anchor: (Width: 213, Height: 38, Right: 10);
          Style: $T.@BtnProfession;
          Label #AssignProfessionButtonText {
            Text: "Dar Emprego";
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #KissButton {
          Anchor: (Width: 213, Height: 38);
          Style: $T.@BtnKiss;
          Visible: false;
          Label #KissButtonText {
            Text: %ui.button.kiss;
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }

      Group #ButtonRow4 {
        Anchor: (Height: 38, Bottom: 6);
        LayoutMode: CenterMiddle;
        Visible: false;

        Button #InventoryButton {
          Anchor: (Width: 213, Height: 38, Right: 10);
          Style: $T.@BtnInventory;
          Visible: false;
          Label #InventoryButtonText {
            Text: %ui.button.inventory;
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
        Button #PregnancyButton {
          Anchor: (Width: 213, Height: 38);
          Style: $T.@BtnPregnancy;
          Visible: false;
          Label #PregnancyButtonText {
            Text: %ui.button.pregnancy;
            Anchor: (Full: 0);
            Style: $T.@ButtonLabelStyle;
          }
        }
      }

      Group #ButtonRow5 {
        Anchor: (Height: 36);
        LayoutMode: CenterMiddle;

        Button #FollowButton {
          Anchor: (Width: 213, Height: 36, Right: 10);
          Style: $T.@BtnFollow;
          Visible: false;
          Label #FollowButtonText {
            Text: %ui.button.follow;
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, FontSize: 14);
          }
        }
        Button #InsultButton {
          Anchor: (Width: 436, Height: 36);
          Style: $T.@BtnDestructive;
          Label #InsultButtonText {
            Text: "Insultar";
            Anchor: (Full: 0);
            Style: (...$T.@ButtonLabelStyle, FontSize: 14);
          }
        }
      }
    }
  }
}
