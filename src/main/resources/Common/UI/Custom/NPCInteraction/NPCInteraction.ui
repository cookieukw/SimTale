Group {
  LayoutMode: MiddleCenter;
  Background: #00000099;
  Group #MainPanel {
    Anchor: (Width: 580, Height: 952);
    LayoutMode: Top;
    Background: #1A1A2EFF;
    Padding: (Top: 24, Bottom: 20, Horizontal: 24);

    Label #NpcName {
      Text: "NPC";
      Anchor: (Width: 520, Height: 52, Bottom: 4);
      Style: (FontSize: 36, TextColor: #E0E0FFFF, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }
    Label #NpcProfession {
      Text: "Profissão: Desempregado";
      Anchor: (Width: 520, Height: 30, Bottom: 2);
      Style: (FontSize: 20, TextColor: #FFD700FF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }
    Label #NpcMood {
      Text: "Humor: Feliz";
      Anchor: (Width: 520, Height: 26, Bottom: 12);
      Style: (FontSize: 18, TextColor: #AAAACCFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    AssetImage #NpcPortrait {
      Anchor: (Width: 150, Height: 150, Bottom: 12);
      AssetPath: "Textures/npc_portrait.png";
    }

    Group #InfoPanel {
      Anchor: (Width: 520, Height: 276, Bottom: 12);
      LayoutMode: Top;
      Background: #16213EFF;
      Padding: (Top: 8, Bottom: 8, Horizontal: 12);

      Label #InfoHeader {
        Text: "INFORMAÇÕES";
        Anchor: (Width: 496, Height: 26, Bottom: 4);
        Style: (FontSize: 18, TextColor: #8888AAFF, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Label #NpcTraits {
        Text: "Traços: —";
        Anchor: (Width: 496, Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #NpcLikes {
        Text: "Gosta de: —";
        Anchor: (Width: 496, Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #88DD88FF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #NpcHates {
        Text: "Odeia: —";
        Anchor: (Width: 496, Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #DD8888FF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #NpcHobby {
        Text: "Hobby: —";
        Anchor: (Width: 496, Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #NpcSeason {
        Text: "Estação Fav.: —";
        Anchor: (Width: 496, Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #NpcFamilyParents {
        Text: "Pais: —";
        Anchor: (Width: 496, Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #NpcFamilyChildren {
        Text: "Filhos: —";
        Anchor: (Width: 496, Height: 24, Bottom: 4);
        Style: (FontSize: 16, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #NpcRelationship {
        Text: "Relacionamento: Desconhecido";
        Anchor: (Width: 496, Height: 24);
        Style: (FontSize: 16, TextColor: #AACCFFFF, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
    }

    Group #ButtonGrid {
      Anchor: (Width: 520, Height: 180);
      LayoutMode: Top;

      Group #ButtonRow1 {
        Anchor: (Width: 520, Height: 52, Bottom: 8);
        LayoutMode: CenterMiddle;
        Button #ChatButton {
          Anchor: (Width: 248, Height: 52, Right: 12);
          Background: #334466FF;
          Label #ChatButtonText {
            Text: "Bater Papo";
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Style: (FontSize: 20, TextColor: #FFFFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
        Button #JokeButton {
          Anchor: (Width: 248, Height: 52);
          Background: #334466FF;
          Label #JokeButtonText {
            Text: "Contar Piada";
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Style: (FontSize: 20, TextColor: #FFFFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }

      Group #ButtonRow2 {
        Anchor: (Width: 520, Height: 52, Bottom: 8);
        LayoutMode: CenterMiddle;
        Button #FlirtButton {
          Anchor: (Width: 248, Height: 52, Right: 12);
          Background: #553355FF;
          Label #FlirtButtonText {
            Text: "Paquerar";
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Style: (FontSize: 20, TextColor: #FFCCFFFF, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
        Button #GiftButton {
          Anchor: (Width: 248, Height: 52);
          Background: #335533FF;
          Label #GiftButtonText {
            Text: "Presentear";
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Style: (FontSize: 20, TextColor: #CCFFCCFF, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }

      Group #ButtonRow3 {
        Anchor: (Width: 520, Height: 52);
        LayoutMode: CenterMiddle;
        Button #InsultButton {
          Anchor: (Width: 248, Height: 52, Right: 12);
          Background: #553333FF;
          Label #InsultButtonText {
            Text: "Insultar";
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Style: (FontSize: 20, TextColor: #FFAAAAFF, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
        Button #AssignProfessionButton {
          Anchor: (Width: 248, Height: 52);
          Background: #445533FF;
          Label #AssignProfessionButtonText {
            Text: "Dar Emprego";
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Style: (FontSize: 20, TextColor: #FFEECCFF, HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }
      }
    }
  }
}
