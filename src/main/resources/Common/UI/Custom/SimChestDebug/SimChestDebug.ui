// Registered chests browser.
//
// SimChestDebugPage addresses the rows by composing ids — "#Row0 #Coords", "#Row2 #BtnTp" and so
// on — so the @ChestRow template, the five #Row0..#Row4 instances and the inner #Coords, #Owner,
// #Contents, #BtnTp and #BtnForget ids all have to keep their names.

$T = "../SimTaleTheme.ui";

@RowH   = 92;
@RowBtnW = 118;
@RowBtnH = 38;

// One chest entry. Taller than the bed row because a chest carries a third line: what is inside
// it, which is the whole reason to open this screen while debugging hunger.
@ChestRow = Group {
  Anchor: (Height: @RowH, Bottom: 8);
  LayoutMode: Left;
  Background: $T.@InsetSurface;
  Padding: (Horizontal: 14, Vertical: 9);

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #Coords {
      Text: "Posição: X: 0, Y: 0, Z: 0";
      Anchor: (Height: 26, Bottom: 2);
      Style: (...$T.@BodyStrong, FontSize: 15);
    }
    Label #Owner {
      Text: "Baú Público";
      Anchor: (Height: 22, Bottom: 2);
      Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@AccentLike);
    }
    Label #Contents {
      Text: "Vazio";
      Anchor: (Height: 22);
      Style: (...$T.@BodyStyle, FontSize: 13);
    }
  }

  Button #BtnTp {
    Anchor: (Width: @RowBtnW, Height: @RowBtnH, Top: 18, Right: 8);
    Style: $T.@BtnNeutral;
    Label { Text: %ui.debugchests.btnTp; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
  }

  // Drops the chest from the registry without touching the block, so it gets the destructive look.
  Button #BtnForget {
    Anchor: (Width: @RowBtnW, Height: @RowBtnH, Top: 18);
    Style: $T.@BtnDestructive;
    Label { Text: %ui.debugchests.btnForget; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
  }
};

Group {
  LayoutMode: MiddleCenter;
  Background: #05070C(0.70);

  Group #MainPanel {
    Anchor: (Width: 640, Height: 700);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Horizontal: $T.@GutterOuter, Vertical: 20);

    Label #Title {
      Text: %ui.debugchests.title;
      Anchor: (Height: 34, Bottom: 4);
      Style: (...$T.@TitleStyle, FontSize: 22, TextColor: $T.@AccentRomance);
    }

    $T.@Separator { @Anchor = (Bottom: 12); }

    Group #ListContainer {
      FlexWeight: 1;
      LayoutMode: Top;

      @ChestRow #Row0 {}
      @ChestRow #Row1 {}
      @ChestRow #Row2 {}
      @ChestRow #Row3 {}
      @ChestRow #Row4 {}
    }

    Group {
      Anchor: (Height: 42, Top: 12, Bottom: 8);
      LayoutMode: Left;

      Button #BtnPrevPage {
        Anchor: (Width: 148, Height: 42, Right: 10);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.debugchests.btnPrev; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
      Label #PageIndex {
        Text: "Página 1 / 1";
        Anchor: (Width: 284, Height: 42, Right: 10);
        Style: (...$T.@BodyStrong, HorizontalAlignment: Center);
      }
      Button #BtnNextPage {
        Anchor: (Width: 148, Height: 42);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.debugchests.btnNext; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
    }

    Button #BtnBack {
      Anchor: (Height: 42);
      Style: $T.@BtnNeutral;
      Label { Text: %ui.debugchests.btnBack; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
    }
  }
}


