// First-login gender pick.
//
// #MaleButton and #FemaleButton carry the click bindings from PlayerGenderPage; the inner
// #MaleContent / #FemaleContent groups and their labels are kept so nothing that walks the
// tree by id breaks.

$T = "../SimTaleTheme.ui";

Group {
  LayoutMode: MiddleCenter;
  // Heavier scrim here than on the other screens: this one blocks progress until answered,
  // so the world behind it should read as clearly out of reach.
  Background: #05070C(0.82);

  Group #GenderPanel {
    Anchor: (Width: 620, Height: 430);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Top: 34, Bottom: 34, Horizontal: 36);

    Label #Title {
      Text: %ui.gender.title;
      Anchor: (Height: 42, Bottom: 6);
      Style: (...$T.@TitleStyle, TextColor: $T.@TextGold);
    }

    $T.@Separator { @Anchor = (Bottom: 12); }

    Label #Subtitle {
      Text: %ui.gender.subtitle;
      Anchor: (Height: 64, Bottom: 26);
      Style: (...$T.@CaptionStyle, FontSize: 15, Wrap: true);
    }

    Group #ButtonsRow {
      FlexWeight: 1;
      LayoutMode: CenterMiddle;

      Button #MaleButton {
        Anchor: (Width: 258, Height: 132, Right: 20);
        Style: $T.@BtnNeutral;

        Group #MaleContent {
          LayoutMode: MiddleCenter;
          Anchor: (Full: 0);
          Label #MaleText {
            Text: %ui.gender.male;
            Style: (...$T.@ButtonLabelStyle, FontSize: 22, TextColor: #BBD6F5);
          }
        }
      }

      Button #FemaleButton {
        Anchor: (Width: 258, Height: 132);
        Style: $T.@BtnSecondary;

        Group #FemaleContent {
          LayoutMode: MiddleCenter;
          Anchor: (Full: 0);
          Label #FemaleText {
            Text: %ui.gender.female;
            Style: (...$T.@ButtonLabelStyle, FontSize: 22, TextColor: $T.@AccentRomance);
          }
        }
      }
    }
  }
}
