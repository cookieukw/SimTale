// Graveyard browser — the dead, and the button that brings them back.
//
// SimGraveyardPage addresses rows by composing ids — "#Row0.Name", "#Row2.BtnRevive" and so on —
// so the @GraveRow template, the five #Row0..#Row4 instances and the inner #Name, #Detail and
// #BtnRevive ids all have to keep their names.

$T = "../SimTaleTheme.ui";

@RowH    = 76;
@RowBtnW = 148;
@RowBtnH = 38;

// One buried NPC. Same card treatment as the bed and chest browsers so the three debug panels
// read as one family.
@GraveRow = Group {
  Anchor: (Height: @RowH, Bottom: 8);
  LayoutMode: Left;
  Background: $T.@InsetSurface;
  Padding: (Horizontal: 14, Vertical: 9);

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #Name {
      Text: "—";
      Anchor: (Height: 28, Bottom: 2);
      Style: (...$T.@BodyStrong, FontSize: 15);
    }
    Label #Detail {
      Text: "—";
      Anchor: (Height: 24);
      Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@TextMuted);
    }
  }

  // Creates an entity and rewrites references across the save — the opposite of destructive, but
  // just as far from reversible, so it does not get the quiet neutral styling.
  Button #BtnRevive {
    Anchor: (Width: @RowBtnW, Height: @RowBtnH, Top: 10);
    Style: $T.@BtnSecondary;
    Label { Text: %ui.graveyard.btnRevive; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
  }
};

Group {
  LayoutMode: MiddleCenter;
  Background: #0C0806(0.85);

  SceneBlur {}

  Group #MainPanel {
    Anchor: (Width: 640, Height: 700);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Horizontal: $T.@GutterOuter, Vertical: 20);

    Label #Title {
      Text: %ui.graveyard.title;
      Anchor: (Height: 34, Bottom: 4);
      Style: (...$T.@TitleStyle, FontSize: 24, TextColor: $T.@TextGold);
    }

    $T.@Separator { @Anchor = (Bottom: 12); }

    Group #EmptyContainer {
      FlexWeight: 1;
      LayoutMode: MiddleCenter;
      Visible: false;

      Group {
        LayoutMode: MiddleCenter;
        Anchor: (Width: 440);

        Group #EmptyIcon {
          Anchor: (Width: 64, Height: 64, Bottom: 16);
          Background: $T.@IconEmptyGraveyard;
        }

        Label #EmptyTitle {
          Text: %ui.graveyard.emptyTitle;
          Anchor: (Height: 28, Bottom: 6);
          Style: (...$T.@TitleStyle, FontSize: 20, TextColor: $T.@TextGold, HorizontalAlignment: Center);
        }

        Label #EmptyNotice {
          Text: %ui.graveyard.emptySubtitle;
          Anchor: (Height: 24);
          Style: (...$T.@CaptionStyle, FontSize: 14, TextColor: $T.@TextMuted, HorizontalAlignment: Center, Wrap: true);
        }
      }
    }

    Group #ListContainer {
      FlexWeight: 1;
      LayoutMode: Top;

      @GraveRow #Row0 {}
      @GraveRow #Row1 {}
      @GraveRow #Row2 {}
      @GraveRow #Row3 {}
      @GraveRow #Row4 {}
    }

    Group {
      Anchor: (Height: 42, Top: 12, Bottom: 8);
      LayoutMode: Left;

      Button #BtnPrevPage {
        Anchor: (Width: 148, Height: 42, Right: 10);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.graveyard.btnPrev; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
      Label #PageIndex {
        Text: "—";
        Anchor: (Width: 284, Height: 42, Right: 10);
        Style: (...$T.@BodyStrong, HorizontalAlignment: Center);
      }
      Button #BtnNextPage {
        Anchor: (Width: 148, Height: 42);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.graveyard.btnNext; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
    }

    Button #BtnBack {
      Anchor: (Height: 42);
      Style: $T.@BtnNeutral;
      Label { Text: %ui.graveyard.btnBack; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
    }
  }
}
