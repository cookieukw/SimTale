// Debug control panel.
//
// A dev tool, so it stays denser than the player-facing screens — but it inherits the same
// surfaces and button states so it does not look like it came from a different mod.
// SimDebugPage binds clicks on the #Btn* ids and writes values via "#StatsX.TextSpans",
// "#NpcName.TextSpans", "#NpcGender.TextSpans", "#NpcTask.TextSpans" and "#NpcIndex.TextSpans".

$T = "../SimTaleTheme.ui";

@DebugBtnW = 272;
@DebugBtnH = 42;

Group {
  LayoutMode: MiddleCenter;
  Background: #0C0806(0.85);

  SceneBlur {}

  Group #MainPanel {
    Anchor: (Width: 590, Height: 700);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Horizontal: $T.@GutterOuter, Vertical: 20);

    Label #Title {
      Text: %ui.simdebug.title;
      Anchor: (Height: 34, Bottom: 4);
      Style: (...$T.@TitleStyle, FontSize: 22, TextColor: $T.@TextGold);
    }

    $T.@Separator { @Anchor = (Bottom: 12); }

    // ---------------------------------------------------------------- subject
    Group {
      Anchor: (Height: 84, Bottom: 12);
      LayoutMode: Top;
      Background: $T.@InsetSurface;
      Padding: (Horizontal: 12, Vertical: 8);

      Label #NpcName {
        Text: %ui.simdebug.npcNone;
        Anchor: (Height: 28, Bottom: 2);
        Style: (...$T.@BodyStrong, FontSize: 19, HorizontalAlignment: Center);
      }
      Label #NpcGender {
        Text: %ui.simdebug.genderUnknown;
        Anchor: (Height: 20, Bottom: 2);
        Style: $T.@CaptionStyle;
      }
      Label #NpcTask {
        Text: %ui.simdebug.taskPlaceholder;
        Anchor: (Height: 20);
        Style: (...$T.@CaptionStyle, TextColor: $T.@TextGold, RenderBold: true);
      }
    }

    // ---------------------------------------------------------------- needs
    Group #StatsPanel {
      Anchor: (Height: 76, Bottom: 12);
      LayoutMode: Top;
      Background: $T.@WellSurface;
      Padding: (Horizontal: 12, Vertical: 10);

      Group {
        Anchor: (Height: 24, Bottom: 8);
        LayoutMode: Left;
        Label #StatsHunger {
          Text: %ui.simdebug.statPlaceholder;
          Anchor: (Width: 268, Height: 24, Right: 10);
          Style: (...$T.@BodyStyle, TextColor: #E08A6B, HorizontalAlignment: Center);
        }
        Label #StatsEnergy {
          Text: %ui.simdebug.statPlaceholder;
          Anchor: (Width: 268, Height: 24);
          Style: (...$T.@BodyStyle, TextColor: #6BB6E0, HorizontalAlignment: Center);
        }
      }
      Group {
        Anchor: (Height: 24);
        LayoutMode: Left;
        Label #StatsSocial {
          Text: %ui.simdebug.statPlaceholder;
          Anchor: (Width: 268, Height: 24, Right: 10);
          Style: (...$T.@BodyStyle, TextColor: $T.@AccentLike, HorizontalAlignment: Center);
        }
        Label #StatsHygiene {
          Text: %ui.simdebug.statPlaceholder;
          Anchor: (Width: 268, Height: 24);
          Style: (...$T.@BodyStyle, TextColor: #A98BE0, HorizontalAlignment: Center);
        }
      }
    }

    // ---------------------------------------------------------------- actions
    Group #ActionPanel {
      Anchor: (Height: 146, Bottom: 12);
      LayoutMode: Top;

      Group {
        Anchor: (Height: @DebugBtnH, Bottom: 8);
        LayoutMode: Left;
        Button #BtnForceEat {
          Anchor: (Width: @DebugBtnW, Height: @DebugBtnH, Right: 10);
          Style: $T.@BtnTertiary;
          Label { Text: %ui.simdebug.btnForceEat; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
        }
        Button #BtnForceSleep {
          Anchor: (Width: @DebugBtnW, Height: @DebugBtnH);
          Style: $T.@BtnNeutral;
          Label { Text: %ui.simdebug.btnForceSleep; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
        }
      }
      Group {
        Anchor: (Height: @DebugBtnH, Bottom: 8);
        LayoutMode: Left;
        Button #BtnForceBath {
          Anchor: (Width: @DebugBtnW, Height: @DebugBtnH, Right: 10);
          Style: $T.@BtnSecondary;
          Label { Text: %ui.simdebug.btnForceBath; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
        }
        Button #BtnForceSocial {
          Anchor: (Width: @DebugBtnW, Height: @DebugBtnH);
          Style: $T.@BtnSecondary;
          Label { Text: %ui.simdebug.btnForceSocial; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14, TextColor: $T.@AccentLike); }
        }
      }
      Group {
        Anchor: (Height: @DebugBtnH);
        LayoutMode: Left;
        // Kills the NPC — destructive styling so it is not clicked by accident.
        Button #BtnSetHungerZero {
          Anchor: (Width: @DebugBtnW, Height: @DebugBtnH, Right: 10);
          Style: $T.@BtnDestructive;
          Label { Text: %ui.simdebug.btnHungerZero; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
        }
        Button #BtnResetNeeds {
          Anchor: (Width: @DebugBtnW, Height: @DebugBtnH);
          Style: $T.@BtnTertiary;
          Label { Text: %ui.simdebug.btnResetNeeds; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14, TextColor: $T.@AccentLike); }
        }
      }
    }

    // ---------------------------------------------------------------- pager
    Group #NpcListPanel {
      Anchor: (Height: @DebugBtnH, Bottom: 10);
      LayoutMode: Left;

      Button #BtnPrevNpc {
        Anchor: (Width: 148, Height: @DebugBtnH, Right: 10);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.simdebug.btnPrev; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
      Label #NpcIndex {
        Text: "1 / 1";
        Anchor: (Width: 238, Height: @DebugBtnH, Right: 10);
        Style: (...$T.@BodyStrong, HorizontalAlignment: Center);
      }
      Button #BtnNextNpc {
        Anchor: (Width: 148, Height: @DebugBtnH);
        Style: $T.@BtnTertiary;
        Label { Text: %ui.simdebug.btnNext; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
    }

    Group #TabPanel {
      Anchor: (Height: @DebugBtnH);
      LayoutMode: Left;
      Button #BtnViewBeds {
        FlexWeight: 1;
        Anchor: (Height: @DebugBtnH, Right: 10);
        Style: $T.@BtnNeutral;
        Label { Text: %ui.simdebug.btnViewBeds; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
      Button #BtnViewChests {
        FlexWeight: 1;
        Anchor: (Height: @DebugBtnH);
        Style: $T.@BtnNeutral;
        Label { Text: %ui.simdebug.btnViewChests; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 14); }
      }
    }
  }
}
