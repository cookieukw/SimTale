$T = "SimTaleTheme.ui";

Group {
  LayoutMode: MiddleCenter;
  Background: #0C0806(0.78);
  SceneBlur {}

  Group #GuideContainer {
    Anchor: (Width: 820, Height: 560);
    Background: #E8D7B5;
    LayoutMode: Left;
    Padding: (Horizontal: 30, Vertical: 28);

    Group #LeftPage {
      Anchor: (Width: 370, Height: 504, Right: 10);
      Background: #F3E7CB;
      Padding: (Horizontal: 24, Vertical: 22);

      Label #LeftTitle {
        Anchor: (Height: 58, Bottom: 8);
        Style: (...$T.@TitleStyle, FontSize: 25, TextColor: #352317, Wrap: true);
      }
      Label #LeftText {
        Anchor: (Top: 98, Bottom: 18);
        Style: (...$T.@BodyStyle, FontSize: 16, TextColor: #493426, Wrap: true);
      }
    }

    Group #RightPage {
      Anchor: (Width: 370, Height: 504);
      Background: #F3E7CB;
      Padding: (Horizontal: 24, Vertical: 22);

      Label #RightTitle {
        Anchor: (Height: 58, Bottom: 8);
        Style: (...$T.@TitleStyle, FontSize: 25, TextColor: #352317, Wrap: true);
      }
      Label #RightText {
        Anchor: (Top: 82, Bottom: 70);
        Style: (...$T.@BodyStyle, FontSize: 16, TextColor: #493426, Wrap: true);
      }

      Group #Nav {
        Anchor: (Height: 44, Bottom: 0);
        LayoutMode: Left;
        Button #Previous {
          Anchor: (Width: 105, Height: 42, Right: 8);
          Style: $T.@BtnSecondary;
          Label { Anchor: (Full: 0); Text: %ui.guide.previous; Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
        }
        Button #Next {
          Anchor: (Width: 105, Height: 42, Right: 8);
          Style: $T.@BtnSecondary;
          Label { Anchor: (Full: 0); Text: %ui.guide.next; Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
        }
        Button #Close {
          Anchor: (Width: 105, Height: 42);
          Style: $T.@BtnTertiary;
          Label { Anchor: (Full: 0); Text: %ui.guide.close; Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
        }
      }
    }
  }
}
