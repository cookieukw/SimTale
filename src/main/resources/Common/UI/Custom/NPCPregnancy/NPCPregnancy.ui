Group {
  LayoutMode: MiddleCenter;
  Background: #00000099;
  Group #MainPanel {
    Anchor: (Width: 580, Height: 760);
    LayoutMode: Top;
    Background: #1A1A2EFF;
    Padding: (Top: 24, Bottom: 24, Horizontal: 24);

    Label #SubjectName {
      Text: "—";
      Anchor: (Width: 520, Height: 52, Bottom: 4);
      Style: (FontSize: 32, TextColor: #E0E0FFFF, RenderUppercase: true, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }
    Label #SubTitle {
      Text: %simtale.ui.pregnancy.subtitle;
      Anchor: (Width: 520, Height: 30, Bottom: 24);
      Style: (FontSize: 20, TextColor: #FF88AAFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Group #InfoPanel {
      Anchor: (Width: 520, Height: 420, Bottom: 32);
      LayoutMode: Top;
      Background: #16213EFF;
      Padding: (Top: 16, Bottom: 16, Horizontal: 20);

      Label #FatherName {
        Text: "—";
        Anchor: (Width: 480, Height: 32, Bottom: 12);
        Style: (FontSize: 18, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #GestationStage {
        Text: "—";
        Anchor: (Width: 480, Height: 32, Bottom: 12);
        Style: (FontSize: 18, TextColor: #FFB3D9FF, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #ElapsedDays {
        Text: "—";
        Anchor: (Width: 480, Height: 32, Bottom: 12);
        Style: (FontSize: 18, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #ProgressText {
        Text: "—";
        Anchor: (Width: 480, Height: 28, Bottom: 8);
        Style: (FontSize: 18, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Group #ProgressBarContainer {
        Anchor: (Width: 480, Height: 20, Bottom: 16);
        LayoutMode: Left;
        Background: #111422FF;
        Group #ProgressBarFill {
          Anchor: (Width: 0, Height: 20);
          Background: #FF88AAFF;
        }
      }
      Label #TimeRemaining {
        Text: "—";
        Anchor: (Width: 480, Height: 32, Bottom: 12);
        Style: (FontSize: 18, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
      Label #Symptoms {
        Text: "—";
        Anchor: (Width: 480, Height: 48, Bottom: 12);
        Style: (FontSize: 16, TextColor: #AAAAFFFF, HorizontalAlignment: Start, VerticalAlignment: Start);
      }
      Label #TotalChildren {
        Text: "—";
        Anchor: (Width: 480, Height: 32, Bottom: 12);
        Style: (FontSize: 18, TextColor: #CCCCDDFF, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
    }

    Button #BackButton {
      Anchor: (Width: 520, Height: 52);
      Background: #334466FF;
      Visible: true;
      Label #BackButtonText {
        Text: %simtale.ui.pregnancy.back;
        Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
        Style: (FontSize: 20, TextColor: #FFFFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
      }
    }
    Button #CloseButton {
      Anchor: (Width: 520, Height: 52);
      Background: #334466FF;
      Visible: false;
      Label #CloseButtonText {
        Text: %simtale.ui.pregnancy.close;
        Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
        Style: (FontSize: 20, TextColor: #FFFFFFFF, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true);
      }
    }
  }
}
