// Pregnancy details.
//
// Ids are the contract with PregnancyDisplayUtil / NPCPregnancyPage: labels are written via
// "#X.TextSpans", the two footer buttons are toggled via "#BackButton.Visible" /
// "#CloseButton.Visible", and the bar is driven by resizing #ProgressBarFill. All preserved.

$T = "../SimTaleTheme.ui";

// One line of the report: a muted caption on the left, the value on the right.
//
// The old layout stacked seven identical full-width labels, so "Father", "State" and "Symptoms"
// all carried the same weight and the eye had nowhere to land. Splitting caption from value gives
// the panel a column to scan down, which is what the other SimTale screens already do.
@ReportRow = Group {
  @Anchor = ();
  @Caption = "";
  @ValueId = "";
  Anchor: (...@Anchor, Height: 26, Bottom: $T.@RowGap);
  LayoutMode: Left;

  Label {
    Text: @Caption;
    Anchor: (Width: 150, Height: 26);
    Style: (...$T.@BodyStyle, FontSize: 14, TextColor: $T.@TextMuted);
  }
};

Group {
  LayoutMode: MiddleCenter;
  // Slightly deeper scrim than before so the panel reads as a modal rather than a sticker.
  Background: #05070C(0.72);

  // 748 was far taller than the content, and the inset well carried FlexWeight: 1, so the extra
  // ~300px became a single empty box under the last row. Sized close to the content now; the
  // remaining slack is still absorbed by the well rather than left as a gap.
  Group #MainPanel {
    Anchor: (Width: 560, Height: 620);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Top: 24, Bottom: 22, Horizontal: $T.@GutterOuter);

    Label #SubjectName {
      Text: "—";
      Anchor: (Height: 42, Bottom: 2);
      Style: $T.@TitleStyle;
    }
    Label #SubTitle {
      Text: %ui.pregnancy.subtitle;
      Anchor: (Height: 24, Bottom: 4);
      Style: (...$T.@SubtitleStyle, TextColor: $T.@AccentRomance);
    }

    $T.@Separator { @Anchor = (Bottom: $T.@SectionGap); }

    Group #InfoPanel {
      LayoutMode: Top;
      FlexWeight: 1;
      Background: $T.@InsetSurface;
      // 16 each side leaves exactly 488 inside, which is what makes the progress track below
      // land on the 480 the Java fill width is calculated against.
      Padding: (Top: 16, Bottom: 16, Horizontal: 16);

      Label #GestationHeader {
        Text: %ui.pregnancy.sectionGestation;
        Anchor: (Height: 20, Bottom: 8);
        Style: $T.@SectionHeaderStyle;
      }

      // The state is the answer the player opened this panel for, so it gets the heading
      // treatment instead of being the second of seven identical rows.
      Label #GestationStage {
        Text: "—";
        Anchor: (Height: 30, Bottom: 10);
        Style: (...$T.@BodyStrong, FontSize: 19, TextColor: $T.@AccentRomance);
      }

      @ReportRow { @Caption = %ui.pregnancy.captionFather;
        Label #FatherName {
          Text: "—";
          FlexWeight: 1;
          Anchor: (Height: 26);
          Style: $T.@BodyStrong;
        }
      }

      @ReportRow { @Caption = %ui.pregnancy.caption_days; @Anchor = (Bottom: 12);
        Label #ElapsedDays {
          Text: "—";
          FlexWeight: 1;
          Anchor: (Height: 26);
          Style: $T.@BodyStrong;
        }
      }

      Label #ProgressText {
        Text: "—";
        Anchor: (Height: 22, Bottom: 6);
        Style: (...$T.@BodyStyle, FontSize: 14);
      }

      // The track keeps a fixed height and the fill is resized from Java, so this cannot become
      // a ProgressBar node without changing that contract.
      //
      // Geometry matters here and was wrong: the track was 18 tall with 3px padding, leaving 12
      // for a fill that Java sets to height 20 — and @WellSurface is a 9-slice with Border 12, so
      // an 18px box has no room for its own corners. That is what rendered as two stray white
      // marks instead of a bar. 28 tall with 4px padding gives the fill its 20 and the slice its
      // borders, and 488 - 8 leaves exactly the 480 the fill width is computed against.
      Group #ProgressBarContainer {
        Anchor: (Height: 28, Bottom: 14);
        LayoutMode: Left;
        Background: $T.@WellSurface;
        Padding: (Full: 4);

        Group #ProgressBarFill {
          Anchor: (Width: 0, Height: 20);
          // Via the theme so this file stays free of ../ paths — those are resolved relative
          // to the file that declares them, and every other texture here comes from
          // SimTaleTheme.ui, which sits one level up.
          Background: $T.@ProgressFill;
        }
      }

      @ReportRow { @Caption = %ui.pregnancy.caption_remaining; @Anchor = (Bottom: 12);
        Label #TimeRemaining {
          Text: "—";
          FlexWeight: 1;
          Anchor: (Height: 26);
          Style: $T.@BodyStrong;
        }
      }

      $T.@Separator { @Anchor = (Bottom: 10); }

      Label #FamilyHeader {
        Text: %ui.pregnancy.sectionFamily;
        Anchor: (Height: 20, Bottom: 8);
        Style: $T.@SectionHeaderStyle;
      }

      Label #Symptoms {
        Text: "—";
        Anchor: (Height: 44, Bottom: 8);
        Style: (...$T.@BodyStyle, FontSize: 14, VerticalAlignment: Start);
      }

      @ReportRow { @Caption = %ui.pregnancy.caption_children; @Anchor = (Bottom: 0);
        Label #TotalChildren {
          Text: "—";
          FlexWeight: 1;
          Anchor: (Height: 26);
          Style: $T.@BodyStrong;
        }
      }
    }

    // Only one of these is visible at a time; Java flips them.
    Button #BackButton {
      Anchor: (Height: $T.@ButtonH, Top: $T.@SectionGap);
      Style: $T.@BtnNeutral;
      Visible: true;
      Label #BackButtonText {
        Text: %ui.pregnancy.back;
        Anchor: (Full: 0);
        Style: $T.@ButtonLabelStyle;
      }
    }
    Button #CloseButton {
      Anchor: (Height: $T.@ButtonH, Top: $T.@SectionGap);
      Style: $T.@BtnNeutral;
      Visible: false;
      Label #CloseButtonText {
        Text: %ui.pregnancy.close;
        Anchor: (Full: 0);
        Style: $T.@ButtonLabelStyle;
      }
    }
  }
}
