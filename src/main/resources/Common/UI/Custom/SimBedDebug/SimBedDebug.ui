Group {
  LayoutMode: MiddleCenter;
  Background: #000000(0.7);

  Group #MainPanel {
    Anchor: (Width: 600, Height: 550);
    LayoutMode: Top;
    Background: #1e1e24;
    Padding: (Horizontal: 20, Vertical: 20);

    Label #Title {
      Text: "SIMBEDDEBUG - Camas Registradas";
      Anchor: (Width: 560, Height: 40, Bottom: 20);
      Style: (FontSize: 24, TextColor: #ff88aaFF, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }
    
    Group {
      Anchor: (Width: 560, Height: 120, Bottom: 30);
      LayoutMode: Top;
      
      Label #BedCoords {
        Text: "Posição: X: 0, Y: 0, Z: 0";
        Anchor: (Width: 560, Height: 30, Bottom: 10);
        Style: (FontSize: 20, TextColor: #ffffffFF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Label #BedYaw {
        Text: "Direção (Yaw): 0°";
        Anchor: (Width: 560, Height: 20, Bottom: 15);
        Style: (FontSize: 16, TextColor: #aaaaaaFF, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Label #BedStatus {
        Text: "Status: LIVRE";
        Anchor: (Width: 560, Height: 30);
        Style: (FontSize: 18, TextColor: #44ff88FF, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
    }

    Group #ActionPanel {
      Anchor: (Width: 560, Height: 100, Bottom: 30);
      LayoutMode: Top;
      
      Group {
        Anchor: (Width: 560, Height: 44, Bottom: 10);
        LayoutMode: Left;
        Button #BtnTeleport {
          Anchor: (Width: 275, Height: 44, Right: 10);
          Background: #3355aaFF;
          Label { Text: "Teletransportar"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true); }
        }
        Button #BtnUnclaim {
          Anchor: (Width: 275, Height: 44);
          Background: #cc5500FF;
          Label { Text: "Desvincular Dono"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true); }
        }
      }
      Group {
        Anchor: (Width: 560, Height: 44);
        LayoutMode: Left;
        Button #BtnBack {
          Anchor: (Width: 560, Height: 44);
          Background: #444455FF;
          Label { Text: "Voltar para Debug de NPCs"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center); }
        }
      }
    }

    Group #BedListPanel {
      Anchor: (Width: 560, Height: 44);
      LayoutMode: Left;
      
      Button #BtnPrevBed {
        Anchor: (Width: 150, Height: 44, Right: 10);
        Background: #444455FF;
        Label { Text: "< Anterior"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Label #BedIndex {
        Text: "1 / 1";
        Anchor: (Width: 240, Height: 44, Right: 10);
        Style: (FontSize: 18, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Button #BtnNextBed {
        Anchor: (Width: 150, Height: 44);
        Background: #444455FF;
        Label { Text: "Proximo >"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }
  }
}
