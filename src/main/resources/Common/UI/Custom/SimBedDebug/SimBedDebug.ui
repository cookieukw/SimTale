@BedRow = Group {
  Anchor: (Width: 610, Height: 80, Bottom: 10);
  LayoutMode: Left;
  Background: #15151a;
  Padding: (Horizontal: 15, Vertical: 10);

  Group {
    Anchor: (Width: 320, Height: 60, Right: 10);
    LayoutMode: Top;
    Label #Coords {
      Text: "Posição: X: 0, Y: 0, Z: 0";
      Anchor: (Width: 320, Height: 30, Bottom: 2);
      Style: (FontSize: 16, TextColor: #ffffffFF, RenderBold: true, VerticalAlignment: Center);
    }
    Label #Status {
      Text: "Status: LIVRE";
      Anchor: (Width: 320, Height: 28);
      Style: (FontSize: 14, TextColor: #44ff88FF, VerticalAlignment: Center);
    }
  }

  Button #BtnTp {
    Anchor: (Width: 120, Height: 40, Top: 10, Right: 10);
    Background: #3355aaFF;
    Label { Text: "Teleport"; Anchor: (Full: 0); Style: (FontSize: 14, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true); }
  }

  Button #BtnUnclaim {
    Anchor: (Width: 120, Height: 40, Top: 10);
    Background: #cc5500FF;
    Label { Text: "Desvincular"; Anchor: (Full: 0); Style: (FontSize: 14, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center, RenderBold: true); }
  }
};

Group {
  LayoutMode: MiddleCenter;
  Background: #000000(0.7);

  Group #MainPanel {
    Anchor: (Width: 650, Height: 700);
    LayoutMode: Top;
    Background: #1e1e24;
    Padding: (Horizontal: 20, Vertical: 20);

    Label #Title {
      Text: "SIMBEDDEBUG - Camas Registradas";
      Anchor: (Width: 610, Height: 40, Bottom: 15);
      Style: (FontSize: 24, TextColor: #ff88aaFF, RenderUppercase: true, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Group #ListContainer {
      Anchor: (Width: 610, Height: 450, Bottom: 15);
      LayoutMode: Top;

      @BedRow #Row0 {}
      @BedRow #Row1 {}
      @BedRow #Row2 {}
      @BedRow #Row3 {}
      @BedRow #Row4 {}
    }

    Group {
      Anchor: (Width: 610, Height: 44, Bottom: 10);
      LayoutMode: Left;
      
      Button #BtnPrevPage {
        Anchor: (Width: 150, Height: 44, Right: 10);
        Background: #444455FF;
        Label { Text: "< Anterior"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
      Label #PageIndex {
        Text: "Página 1 / 1";
        Anchor: (Width: 290, Height: 44, Right: 10);
        Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center);
      }
      Button #BtnNextPage {
        Anchor: (Width: 150, Height: 44);
        Background: #444455FF;
        Label { Text: "Próximo >"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center); }
      }
    }

    Button #BtnBack {
      Anchor: (Width: 610, Height: 44);
      Background: #33333bFF;
      Label { Text: "Voltar para Debug de NPCs"; Anchor: (Full: 0); Style: (FontSize: 16, TextColor: #ffffffFF, HorizontalAlignment: Center, VerticalAlignment: Center); }
    }
  }
}
