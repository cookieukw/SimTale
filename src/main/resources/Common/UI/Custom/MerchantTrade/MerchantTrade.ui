// Merchant trade surface mockup.
//
// This file is intentionally self-contained at the page level: a future
// MerchantTradePage can append it and bind the documented ids without
// coupling this presentation layer to merchant, stock, or currency classes.

$T = "../SimTaleTheme.ui";

@ItemRow = Group {
  Anchor: (Height: 76, Bottom: 8);
  LayoutMode: Left;
  Background: $T.@InsetSurface;
  Padding: (Horizontal: 14, Vertical: 9);

  Group #ItemIcon {
    Anchor: (Width: 54, Height: 54, Right: 14);
    Background: $T.@IconEmptyChest;
  }

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #ItemName {
      Text: "Item name";
      Anchor: (Height: 26, Bottom: 2);
      Style: (...$T.@BodyStrong, FontSize: 15);
    }
    Label #ItemMeta {
      Text: "Description · In stock";
      Anchor: (Height: 22);
      Style: (...$T.@BodyStyle, FontSize: 13, TextColor: $T.@TextMuted);
    }
  }

  Label #ItemPrice {
    Text: "12 coins";
    Anchor: (Width: 104, Height: 38, Top: 10, Right: 10);
    Style: (...$T.@BodyStrong, FontSize: 14, TextColor: $T.@TextGold, HorizontalAlignment: Center);
  }

  Button #BtnSell {
    Anchor: (Width: 92, Height: 38, Top: 10, Right: 8);
    Style: $T.@BtnTertiary;
    Label #SellLabel { Text: "SELL"; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
  }

  Button #BtnBuy {
    Anchor: (Width: 100, Height: 38, Top: 10);
    Style: $T.@BtnSecondary;
    Label #BuyLabel { Text: "BUY"; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
  }
};

Group {
  LayoutMode: MiddleCenter;
  Background: #0C0806(0.85);
  SceneBlur {}

  Group #MainPanel {
    Anchor: (Width: 760, Height: 640);
    LayoutMode: Top;
    Background: $T.@PanelSurface;
    Padding: (Horizontal: $T.@GutterOuter, Vertical: 20);

    Group {
      Anchor: (Height: 58, Bottom: 4);
      LayoutMode: Left;

      Group {
        FlexWeight: 1;
        LayoutMode: Top;
        Label #Title {
          Text: "Mara's Traveling Stall";
          Anchor: (Height: 32);
          Style: (...$T.@TitleStyle, FontSize: 24, TextColor: $T.@TextGold);
        }
        Label #Subtitle {
          Text: "Fresh finds from the road · Open for trade";
          Anchor: (Height: 22);
          Style: (...$T.@CaptionStyle, FontSize: 13, TextColor: $T.@TextMuted);
        }
      }

      Group #Wallet {
        Anchor: (Width: 158, Height: 42, Top: 5);
        Background: $T.@InsetSurface;
        Padding: (Horizontal: 12, Vertical: 8);
        Label #Balance {
          Text: "Balance  240 coins";
          Anchor: (Full: 0);
          Style: (...$T.@BodyStrong, FontSize: 14, TextColor: $T.@TextGold, HorizontalAlignment: Center);
        }
      }
    }

    $T.@Separator { @Anchor = (Bottom: 12); }

    Group #CategoryTabs {
      Anchor: (Height: 42, Bottom: 12);
      LayoutMode: Left;
      Button #TabFeatured { Anchor: (Width: 150, Height: 42, Right: 8); Style: $T.@BtnSecondary; Label { Text: "FEATURED"; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 12); } }
      Button #TabMaterials { Anchor: (Width: 150, Height: 42, Right: 8); Style: $T.@BtnTertiary; Label { Text: "MATERIALS"; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 12); } }
      Button #TabCurios { Anchor: (Width: 150, Height: 42); Style: $T.@BtnTertiary; Label { Text: "CURIOS"; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 12); } }
    }

    Group #ItemList {
      FlexWeight: 1;
      LayoutMode: Top;
      @ItemRow #Row0 {}
      @ItemRow #Row1 {}
      @ItemRow #Row2 {}
      @ItemRow #Row3 {}
      @ItemRow #Row4 {}
    }

    Group {
      Anchor: (Height: 48, Top: 10);
      LayoutMode: Left;
      Label #Status {
        Text: "Select an item to see details";
        FlexWeight: 1;
        Anchor: (Height: 42, Top: 3);
        Style: (...$T.@CaptionStyle, FontSize: 13, TextColor: $T.@TextMuted);
      }
      Button #BtnClose {
        Anchor: (Width: 142, Height: 42);
        Style: $T.@BtnNeutral;
        Label #CloseLabel { Text: "CLOSE"; Anchor: (Full: 0); Style: (...$T.@ButtonLabelStyle, FontSize: 13); }
      }
    }
  }
}
